<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "veracrypt.mount">
<!ENTITY author    "bentrop">
<!ENTITY version   "2026.11.27q">
<!ENTITY sha256    "8160848e4d45f1a39283ecaa1542255cb032eccd390da0781e12e2e3f375f28f">
<!ENTITY launch    "Settings/VeraCryptMount">
<!ENTITY gitURL    "https://github.com/bentrop/unraid-veracrypt-mount">
<!ENTITY pluginURL "https://raw.githubusercontent.com/bentrop/unraid-veracrypt-mount/main/plugin/&name;.plg">
<!ENTITY package   "&name;-&version;-noarch-1.txz">
<!ENTITY flash     "/boot/config/plugins/&name;">
]>
<!--
VeraCrypt Mount: mounts VeraCrypt volumes with Unraid's built-in cryptsetup.
The version and the SHA256 above are written by scripts/build.py; do not edit
them by hand. Laid out as Unraid's own plugins do it (dynamix.system.info by
Bergware): one Slackware package, installed with upgradepkg and removed with
removepkg, so every file it brings is also taken away again.
-->
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&pluginURL;" support="&gitURL;/issues" icon="veracrypt.mount.png" min="7.4.0">

<CHANGES>
##VeraCrypt Mount

###&version;
- See the commit history on GitHub.
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p &flash;
true
</INLINE>
</FILE>

<!-- The package. Downloaded only when the flash drive does not already hold this
     version; the plugin manager checks the SHA256 either way. -->
<FILE Name="&flash;/&package;" Run="upgradepkg --install-new --reinstall">
<URL>&gitURL;/releases/download/&version;/&package;</URL>
<SHA256>&sha256;</SHA256>
</FILE>

<!-- The minute check (DOC-6, LIFE-8): stops dependents started while their
     volume is locked, and locks idle volumes. Unraid's update_cron collects
     the *.cron files of installed plugins from their folder on the flash drive
     into the system's job list, as for its own plugins. -->
<FILE Run="/bin/bash">
<INLINE>
# The plugin manager never overwrites an existing file, so a changed line
# would not arrive with an update. Only remove the old file if its command
# differs, so normal reboots do not rewrite the flash drive (audit S2).
grep -qF '/usr/local/emhttp/plugins/&name;/scripts/vcmount check ' &flash;/&name;.cron 2&gt;/dev/null || rm -f &flash;/&name;.cron
</INLINE>
</FILE>

<FILE Name="&flash;/&name;.cron">
<INLINE>
# VeraCrypt Mount: stop dependents of locked volumes, lock idle volumes
* * * * * /usr/local/emhttp/plugins/&name;/scripts/vcmount check &gt;/dev/null 2&gt;&amp;1
</INLINE>
</FILE>

<!-- update_cron takes only plugins already listed in /var/log/plugins, and
     the plugin manager lists this one only after these steps, on a fresh
     install and at boot. So if the line is still missing, add it as
     update_cron does; its next run includes the file anyway. -->
<FILE Run="/bin/bash">
<INLINE>
/usr/local/sbin/update_cron
if ! grep -qF '/usr/local/emhttp/plugins/&name;/scripts/vcmount check ' /etc/cron.d/root 2&gt;/dev/null; then
  { grep -vF '/usr/local/emhttp/plugins/&name;/scripts/vcmount idle-check' /etc/cron.d/root 2&gt;/dev/null; echo ""; cat &flash;/&name;.cron; } | crontab -c /etc/cron.d -
fi
</INLINE>
</FILE>

<!-- Only now, after the new package was downloaded, checked and installed,
     remove packages of other versions from the flash drive (audit S8). If the
     download or the check fails, the plugin manager stops before this step
     and the old package stays. -->
<FILE Run="/bin/bash">
<INLINE>
for old in &flash;/&name;-*.txz; do
  [ -e "$old" ] &amp;&amp; [ "$(basename "$old")" != "&package;" ] &amp;&amp; rm -f "$old"
done
# Status files of older versions, now in /var/run/vcmount/ (audit S12).
rm -f /var/run/vcmount.lock /var/run/vcmount.cancel /var/run/vcmount.unlocking /var/run/vcmount.idle /var/run/vcmount.idle-error /var/run/vcmount.stray
echo ""
echo "-----------------------------------------------------------"
echo " VeraCrypt Mount &version; is installed."
echo " Settings > User Utilities > VeraCrypt Mount, or vcmount over SSH."
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Removal. Volumes are dismounted first, never forced: if one is still in
     use, the removal stops and nothing is taken away, so no volume is left
     mounted without the hooks that dismount it when the array stops. The
     saved volume list (volumes.json) stays on the flash drive. -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
if [ -x /usr/local/emhttp/plugins/&name;/scripts/vcmount ]; then
  code=0
  for _ in 1 2 3; do
    /usr/local/emhttp/plugins/&name;/scripts/vcmount dismount --all
    code=$?
    [ "$code" -ne 6 ] &amp;&amp; break
    sleep 2
  done
  if [ "$code" -eq 6 ]; then
    echo "Not removed: another vcmount action is still running. Wait a moment and remove the plugin again."
    exit 1
  elif [ "$code" -ne 0 ]; then
    echo "Not removed: a volume is still mounted and in use. Dismount it, then remove the plugin again."
    exit 1
  fi
fi
rm -f &flash;/&name;.cron
/usr/local/sbin/update_cron
removepkg &name;
rmdir /etc/samba/veracrypt-shares 2&gt;/dev/null
rm -f &flash;/&name;-*.txz
if [ -d /var/run/vcmount ] &amp;&amp; [ ! -L /var/run/vcmount ]; then
  rm -rf /var/run/vcmount
fi
rm -f /var/run/vcmount.lock /var/run/vcmount.cancel /var/run/vcmount.unlocking /var/run/vcmount.idle /var/run/vcmount.idle-error /var/run/vcmount.stray
echo ""
echo "-----------------------------------------------------------"
echo " VeraCrypt Mount has been removed."
echo " Your volume list stays in &flash;/volumes.json."
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
