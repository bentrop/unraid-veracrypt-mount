     so each tab draws its own, written as Unraid's tab_title() writes it. -->
<div class="title">
  <span class="left inline-flex flex-row items-center gap-1"><i class="fa fa-cog title"></i>Settings</span>
  <span class="right inline-flex flex-row items-center gap-1"></span>
</div>

<form id="vcs-form" autocomplete="off" onsubmit="return false">
  <!-- One list per setting, each followed by its help text: Unraid's help toggle
