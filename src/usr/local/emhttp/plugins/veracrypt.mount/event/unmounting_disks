#!/bin/bash
# unmounting_disks: dismount every volume before the array disks unmount (LIFE-1).
#
# Unraid runs this file when the array stops, after the network services have
# stopped and before any disk is unmounted. Unraid waits until it has finished,
# so everything here has a time limit.
#
# It contains no mount logic. It calls the engine:
# vcmount dismount --all --array-stop.
# The dismount is forced (LIFE-10): programs that still hold a volume open are
# ended, then the volume is dismounted normally. The setting
# "force_at_array_stop" turns this off; a volume that is still in use then
# stays mounted, the engine writes to the system log which programs hold it
# open, and Unraid waits for the disk that holds the volume file.
#
# The time limit: at shutdown and reboot Unraid gives the whole array stop
# (Docker, virtual machines, services, this hook, the disks) its "shutdown
# time-out" and forces the shutdown when that runs out. The hook
# stopping_docker may already have used half of it. This hook therefore takes
# at most a quarter of that time-out, and never less than 20 seconds.

VCMOUNT="$(dirname "$0")/../scripts/vcmount"
# dev-only-begin (scripts/build.py leaves this out of the package)
# Development only: if a file volumes.dev.json lies next to the engine, the
# engine reads it instead of the configuration on the flash drive. The package
# never contains that file; scripts/deployhook.sh puts it there for tests.
DEV_CONFIG="$(dirname "$0")/../scripts/volumes.dev.json"
[ -f "$DEV_CONFIG" ] && export VCMOUNT_CONFIG="$DEV_CONFIG"
# dev-only-end
VAR_INI=/var/local/emhttp/var.ini
WAIT=5   # seconds between tries while another vcmount action is running

say() { logger -t veracrypt.mount "array stop: $*"; }

# Unraid's shutdown time-out in seconds; 90 if it cannot be read.
shutdown_timeout=$(sed -n 's/^shutdownTimeout="\{0,1\}\([0-9]\{1,5\}\)"\{0,1\}[[:space:]]*$/\1/p' "$VAR_INI" 2> /dev/null | head -n 1)
shutdown_timeout=${shutdown_timeout:-90}
budget=$((shutdown_timeout / 4))
[ "$budget" -ge 20 ] || budget=20

SECONDS=0   # bash counts the seconds since this line by itself
code=0
cancelled=no
while :; do
    left=$((budget - SECONDS))
    [ "$left" -gt 0 ] || break
    [ "$left" -le 9999 ] || left=9999
    # The engine fits its work into the time left (--within). Should it still
    # run over, the stop signal lets it finish the volume it is working on;
    # 15 seconds later it is ended for good (audit S2).
    timeout -k 15 "$left" "$VCMOUNT" dismount --all --array-stop --within "$left" < /dev/null > /dev/null 2>&1
    code=$?
    # Code 6: another vcmount action is still running. If it is an unlock,
    # cancel it first (UI-8): it must not hold up the array stop (audit S2).
    [ "$code" -eq 6 ] || break
    if [ "$cancelled" = no ]; then
        "$VCMOUNT" cancel-unlock < /dev/null > /dev/null 2>&1
        cancelled=yes
        sleep 2
    else
        sleep "$WAIT"
    fi
done

case "$code" in
    0) ;;
    5) say "not every volume could be dismounted" ;;
    6) say "another vcmount action was still running; volumes were not dismounted" ;;
    137) say "vcmount had to be ended after its time ran out" ;;
    124) say "dismounting took longer than $budget seconds and was stopped" ;;
    *) say "vcmount ended with code $code" ;;
esac

# Always report success: Unraid's array stop does not depend on this result.
exit 0
