#!/usr/bin/php
<?php
/*
 * vcmount: the engine of the VeraCrypt Mount plugin for Unraid.
 *
 * The web pages and the event hooks call this program; they contain no mount
 * logic of their own. The design is in docs/DESIGN-engine.md.
 *
 * Built so far: list, status, mount, dismount (also forced), for volumes that
 * open with a password; dependents that are single containers; SMB shares and
 * the check for network clients (VOL-7); keyfiles, PIM and hidden volumes.
 * Not built yet: Compose stacks.
 *
 * This program never reads a password. cryptsetup reads it directly from
 * standard input.
 */

// Where the saved volumes are kept. Contains no secrets.
// For development, the environment variable VCMOUNT_CONFIG names another file.
const DEFAULT_CONFIG = '/boot/config/plugins/veracrypt.mount/volumes.json';

// An unlocked volume appears as /dev/mapper/vcm-<name>. The prefix marks it as
// ours; the engine never touches a device without it.
const MAPPER_DIR = '/dev/mapper';
const MAPPER_PREFIX = 'vcm-';

// A volume name: letters, digits, - and _, at most 32 characters.
const NAME_PATTERN = '/\A[A-Za-z0-9][A-Za-z0-9_-]{0,31}\z/';

// Result codes (docs/DESIGN-engine.md, section 3).
const CODE_OK = 0;
const CODE_USAGE = 1;          // wrong usage or a fault in the configuration
const CODE_UNLOCK_FAILED = 2;  // wrong password, PIM or keyfile
const CODE_REFUSED = 3;        // refused by a safety check, nothing changed
const CODE_FILESYSTEM = 4;     // could not be mounted, volume locked again
const CODE_BUSY = 5;           // dismount aborted, volume stays mounted
const CODE_IN_PROGRESS = 6;    // another vcmount action is still running
const CODE_DEPENDENT = 7;      // mounted, but a dependent could not be started
const CODE_SHARE = 8;          // mounted, but the SMB share could not be added

// A container name as Docker allows it. It cannot start with "-", so it can
// never be misread as an option.
const CONTAINER_PATTERN = '/\A[A-Za-z0-9][A-Za-z0-9_.-]{0,127}\z/';

// Unraid's own program for sending a notification.
const NOTIFY_SCRIPT = '/usr/local/emhttp/webGui/scripts/notify';

// Seconds a dependent gets to stop by itself before Docker kills it (DOC-4).
const DEFAULT_GRACE = 10;    // as Docker's own docker stop

// Seconds a program or container gets to end by itself in a forced dismount.
const FORCE_WAIT = 10;

// SMB shares (docs/DESIGN-engine.md, section 9b). All of /etc/samba is in RAM.
// Unraid's smb.conf includes SMB_HOOK; it belongs to Unassigned Devices, which
// keeps our include lines as long as the files they name exist.
const SHARE_DIR = '/etc/samba/veracrypt-shares';
const SMB_HOOK = '/etc/samba/smb-unassigned.conf';
// Unraid's own state file; shareSMBEnabled says whether SMB is turned on.
const UNRAID_VARS = '/var/local/emhttp/var.ini';
// A user name as Unraid allows it.
const USER_PATTERN = '/\A[a-z_][a-z0-9_-]{0,31}\z/';
// Samba gives these section names a special meaning (audit S9, B17.1).
const RESERVED_SHARES = ['global', 'homes', 'printers', 'print$', 'ipc$'];

// The plugin's yes/no settings and their defaults.
const SETTINGS = [
    'force_at_array_stop' => true,   // LIFE-10
    'require_https' => true,         // UI-5; on by default since 2026-11-17 (review P1)
    'show_on_main' => false,         // UI-3
    'log_names' => false,            // PRIV-1: name volumes and containers in log lines and notifications
];

// The largest settings file save-config accepts, in bytes.
const MAX_CONFIG_SIZE = 1048576;

// Runtime files live in one root-only folder in RAM (mode 0700), verified not
// to be a link and owned by root before use (audit S12, review C4).
const RUN_DIR = '/var/run/vcmount';
// Held while an action that changes something runs.
const LOCK_FILE = RUN_DIR . '/lock';
// Created by "vcmount cancel-unlock"; holds the token of the one unlock it is
// meant for, so a late cancel never stops the next unlock (UI-8, review C3).
const CANCEL_FILE = RUN_DIR . '/cancel';
const CANCEL_POLL = 500000;    // microseconds between looks for CANCEL_FILE
// Holds "<start-time> <token>" while cryptsetup runs, so "busy" can tell a
// waiting page that an unlock is under way and a cancel names only that unlock.
// No volume name, path, password or PIM.
const UNLOCKING_FILE = RUN_DIR . '/unlocking';
// Opaque hex token tying a cancel to one unlock (review C3).
const UNLOCK_TOKEN_PATTERN = '/\A[0-9a-f]{16,64}\z/';
// Idle lock (LIFE-8): per watched volume, its kernel device, the read and write
// counters last seen and since when they have not changed. In RAM only.
const IDLE_FILE = RUN_DIR . '/idle';
const IDLE_MIN = 5;            // minutes, the shortest idle lock time
const IDLE_MAX = 1440;         // minutes, one day
// Exists while the idle check fails, so the failure is reported once only.
const IDLE_ERROR_FILE = RUN_DIR . '/idle-error';
// DOC-6: dependents that could not be stopped, with when that failed, so an
// unstoppable container does not retry and flood notifications every minute.
const STRAY_FAILED_FILE = RUN_DIR . '/stray';
const STRAY_BACKOFF = 3600;    // seconds before retrying a dependent that failed to stop
// Written by "cancel-unlock --array-stop" from the array-stop and Docker-stop
// hooks: the time a stop was asked for. Long actions that hold the lock (the
// minute check, dependents' start delays) give way to it (audit 2026-11-27c S1).
const STOP_FILE = RUN_DIR . '/stop';

// Time limits in seconds, so the engine can never hang forever.
const UNLOCK_TIMEOUT = 180;    // cryptsetup checking a password (slow on purpose)
const KILL_GRACE = 5;          // seconds between asking a timed-out program to stop and ending it
const TOOL_TIMEOUT = 60;       // every other program

const USAGE = <<<TEXT
Usage:
  vcmount list                               list saved volumes and anything mounted
  vcmount status <name>                      show one volume
  vcmount mount <name> [--read-only]         unlock and mount a saved volume
  vcmount mount --file <path> --name <name> [--read-only] [--keyfile <path>]...
                [--pim] [--hidden]           mount without saving
      You are asked for the password and, with a PIM (saved with the volume,
      or --pim), for the PIM after it. Keyfiles are given by path, under
      /mnt/; --keyfile may be repeated. --hidden opens the hidden volume.
  vcmount dismount <name> [--force]          stop the dependents, dismount and lock
  vcmount dismount --all [--force]           the same for every mounted volume
  vcmount dismount --all --array-stop        as the array-stop hook calls it: forced
                                             unless the setting turns that off
  vcmount stop-dependents --all              stop the dependents of every mounted volume
      With --within <seconds> (also for dismount --all) the work is fitted
      into that time: shorter grace periods, and what does not fit is left.
  vcmount start-dependents --all             start the dependents of every mounted volume
  vcmount cancel-unlock                      stop a mount that is still checking the password
  vcmount repair-shares                      make the SMB shares match the mounted volumes
  vcmount options                            list the users and containers the forms offer
  vcmount busy                               say whether another vcmount action is running
  vcmount check                              run every minute by cron: stop dependents of
                                             locked volumes (DOC-6), then lock the volumes
                                             idle for their set time (never forced)
  vcmount idle-check                         the same (its earlier name)
  vcmount info <name>                        details of one volume: file, encryption,
                                             filesystem, share, dependents, recent log
  vcmount fix-top <name>                     make the top folder of a mounted ext4, XFS or
                                             Btrfs volume writable for its network share
  vcmount fix-permissions <name>             set everything inside a mounted volume to
                                             nobody:users, as Unraid's New Permissions
  vcmount privacy                            check activity-logging plugins (PRIV-3): the
                                             exclusion line File Activity needs, if any
  vcmount config                             show the saved settings and their revision
  vcmount save-config [--revision <r>]       check new settings (JSON on standard input)
                                             and save them; with --revision only if the
                                             file is still the one read with "config"
  vcmount help                               show this text

A dependent that does not stop within its grace period is killed.
The web page adds --over-http to a mount whose password came over plain HTTP;
it is refused while the setting "require_https" is on.
Without --force a volume that is still in use stays mounted. With --force the
programs and containers that hold it open are ended, then it is dismounted.
Add --json to any command for machine-readable output.
The password is read from standard input by cryptsetup, never from the command line.
Just run the command: you will be asked for the password (and the PIM), and
neither is shown.
Never put it on the command line (no "echo password | vcmount ..."): the shell
would keep it in its history.
TEXT;

/** An error that ends the run. Its code is the result code. */
class Fail extends Exception
{
    /** Extra facts for the caller, for example which programs hold a volume open. */
    public array $details = [];
}

/**
 * Read the saved volumes. Returns a list indexed by volume name.
 * A missing file means "no saved volumes".
 */
function config_path(): string
{
    $path = getenv('VCMOUNT_CONFIG');
    return $path === false || $path === '' ? DEFAULT_CONFIG : $path;
}

/**
 * One yes/no setting from the "settings" part of the configuration file.
 * A missing or unreadable file or setting gives the default.
 */
function setting(string $key, bool $default): bool
{
    // A setting that is not yes or no gives the default, so a fault in the
    // file never blocks the array-stop hook.
    $data = json_decode((string) @file_get_contents(config_path()), true);
    $given = is_array($data) ? ($data['settings'] ?? null) : null;
    $value = is_array($given) ? ($given[$key] ?? null) : null;
    return is_bool($value) ? $value : $default;
}

function load_config(): array
{
    $path = config_path();
    if (!is_file($path)) {
        return [];
    }
    $data = json_decode((string) file_get_contents($path), true);
    return check_config($data, "The configuration file $path")['volumes'];
}

/**
 * Check settings as they come from the file or from save-config. $source names
 * them in error messages. Returns 'volumes' (indexed by name) and 'settings'.
 * Used for both, so there is only one set of rules (Decision U1).
 */
function check_config($data, string $source): array
{
    if (!is_array($data) || !is_array($data['volumes'] ?? null)) {
        throw new Fail("$source is not valid.", CODE_USAGE);
    }
    $given = $data['settings'] ?? [];
    if (!is_array($given)) {
        throw new Fail("$source has settings that are not valid.", CODE_USAGE);
    }
    $settings = [];
    foreach (SETTINGS as $key => $default) {
        $value = $given[$key] ?? $default;
        if (!is_bool($value)) {
            throw new Fail("$source has a setting \"$key\" that is not yes or no.", CODE_USAGE);
        }
        $settings[$key] = $value;
    }

    $volumes = [];
    foreach ($data['volumes'] as $entry) {
        $name = is_array($entry) ? ($entry['name'] ?? null) : null;
        if (!is_string($name) || !preg_match(NAME_PATTERN, $name)) {
            throw new Fail("$source contains a volume with an invalid name.", CODE_USAGE);
        }
        if (isset($volumes[$name])) {
            throw new Fail("$source contains the volume \"$name\" twice.", CODE_USAGE);
        }
        $file = $entry['file'] ?? null;
        if (!is_string($file) || !plain_mnt_path($file)) {
            throw new Fail("The volume \"$name\" has no valid path to its volume file (a file under /mnt/).", CODE_USAGE);
        }
        $display = $entry['display_name'] ?? null;
        $mount_at = $entry['mount_at'] ?? null;
        if (($display !== null && !is_string($display)) || ($mount_at !== null && !is_string($mount_at))
            || (is_string($display) && (mb_strlen($display, 'UTF-8') > 100 || preg_match('/[\x00-\x1f\x7f]/', $display)))
            || (is_string($mount_at) && $mount_at !== '' && !valid_mount_at($mount_at))) {
            throw new Fail("The volume \"$name\" has a display name or mount location that is not valid.", CODE_USAGE);
        }

        $idle = $entry['idle_lock'] ?? null;
        if ($idle !== null && (!is_int($idle) || $idle < IDLE_MIN || $idle > IDLE_MAX)) {
            throw new Fail("The volume \"$name\" has an idle lock time that is not valid (" . IDLE_MIN
                . ' to ' . IDLE_MAX . ' minutes).', CODE_USAGE);
        }

        $volumes[$name] = [
            'name' => $name,
            'display_name' => is_string($display) && $display !== '' ? $display : $name,
            'file' => $file,
            'mount_at' => is_string($mount_at) && $mount_at !== '' ? $mount_at : "/mnt/addons/$name",
            'read_only' => !empty($entry['read_only']),
            'hidden' => !empty($entry['hidden']),
            'pim' => !empty($entry['pim']),
            'keyfiles' => read_keyfiles($name, $entry['keyfiles'] ?? [], $file),
            'dependents' => read_dependents($name, $entry['dependents'] ?? []),
            'share' => read_share($name, $entry['share'] ?? null),
            'idle_lock' => $idle,
        ];
    }
    return ['volumes' => $volumes, 'settings' => $settings];
}

/** At most this many keyfiles per volume. */
const MAX_KEYFILES = 8;

/**
 * Check a list of keyfile paths (KEY-2, KEY-3, audit B17.1). Only the paths are
 * stored, never what the files contain. $volume names the volume in error
 * messages; when $volume_file is given, the volume file cannot be its own keyfile.
 */
function read_keyfiles(string $volume, $list, ?string $volume_file = null): array
{
    $fault = new Fail("The volume \"$volume\" has a keyfile path that is not valid.", CODE_USAGE);
    if (!is_array($list) || count($list) > MAX_KEYFILES) {
        throw $fault;
    }
    $paths = [];
    foreach ($list as $path) {
        if (!is_string($path) || !plain_mnt_path($path)) {
            throw $fault;
        }
        if ($volume_file !== null && same_file($path, $volume_file)) {
            throw new Fail('The volume file cannot be its own keyfile.', CODE_USAGE);
        }
        $paths[] = $path;
    }
    return array_values(array_unique($paths));
}

/**
 * Check that every keyfile is an ordinary, readable file under /mnt/ (shares,
 * disks, removable drives) and not the volume file itself. One message for
 * every refusal, so the answer does not tell which files exist elsewhere (SEC-3).
 * Returns the resolved paths for cryptsetup.
 */
function check_keyfiles(array $keyfiles, string $volume_file): array
{
    $resolved = [];
    foreach ($keyfiles as $path) {
        $real = realpath($path);
        if ($real === false || !str_starts_with($real, '/mnt/') || !is_file($real) || !is_readable($real)) {
            throw new Fail("The keyfile $path cannot be used: it must be a readable file under /mnt/. If it is on a removable drive, connect it first.", CODE_USAGE);
        }
        if (same_file($real, $volume_file)) {
            throw new Fail('The volume file cannot be its own keyfile.', CODE_USAGE);
        }
        $resolved[] = $real;
    }
    return $resolved;
}

/**
 * Check the "dependents" list of one saved volume. The order of the list is
 * the order in which the containers are started. Each entry:
 *   container: the name of the Docker container
 *   grace:     seconds it gets to stop by itself, default 10
 *   delay:     seconds to wait after starting it, default 0
 */
function read_dependents(string $volume, $list): array
{
    $fault = new Fail("The volume \"$volume\" has a dependent that is not valid.", CODE_USAGE);
    if (!is_array($list)) {
        throw $fault;
    }
    $dependents = [];
    foreach ($list as $entry) {
        $container = is_array($entry) ? ($entry['container'] ?? null) : null;
        $grace = $entry['grace'] ?? DEFAULT_GRACE;
        $delay = $entry['delay'] ?? 0;
        if (!is_string($container) || !preg_match(CONTAINER_PATTERN, $container)
            || !is_int($grace) || $grace < 1 || $grace > 600
            || !is_int($delay) || $delay < 0 || $delay > 600) {
            throw $fault;
        }
        $dependents[] = ['container' => $container, 'grace' => $grace, 'delay' => $delay];
    }
    return $dependents;
}

/**
 * Check the "share" entry of one saved volume (SHR-1, SHR-2). Returns null when
 * the volume is not shared. Like Unraid's own "Private" share security
 * (decision 2026-11-16): only the users listed may connect, each read-write or
 * read-only. Guests never get access, so Unraid's "Public" and "Secure" levels
 * are not offered. Entry:
 *   export: "yes", or "hidden" to hide it from network browsing; default "yes"
 *   users:  {"<user>": "read-write" | "read-only", ...}, at least one
 */
function read_share(string $volume, $entry): ?array
{
    if ($entry === null || $entry === false) {
        return null;
    }
    if (in_array(strtolower($volume), RESERVED_SHARES, true)) {
        throw new Fail("No share for \"$volume\": Samba reserves that name. Rename the volume to share it.", CODE_USAGE);
    }
    $fault = new Fail("The volume \"$volume\" has share settings that are not valid.", CODE_USAGE);
    if (!is_array($entry) || !is_array($entry['users'] ?? null) || $entry['users'] === []) {
        throw $fault;
    }
    $export = $entry['export'] ?? 'yes';
    if (!in_array($export, ['yes', 'hidden'], true)) {
        throw $fault;
    }
    $users = [];
    foreach ($entry['users'] as $user => $access) {
        if (!is_string($user) || !preg_match(USER_PATTERN, $user)
            || !in_array($access, ['read-write', 'read-only'], true)) {
            throw $fault;
        }
        $users[$user] = $access;
    }
    ksort($users);
    return ['export' => $export, 'users' => $users];
}

/**
 * The kernel's own name ("dm-3") for a device path such as /dev/mapper/vcm-x.
 * Returns null if the device does not exist.
 */
function dm_name(string $device): ?string
{
    $real = realpath($device);
    if ($real === false) {
        return null;
    }
    $base = basename($real);
    if (preg_match('/\Adm-\d+\z/', $base)) {
        return $base;
    }
    // Not a link to /dev/dm-N: work the number out from the device itself.
    $info = @stat($real);
    if ($info === false) {
        return null;
    }
    $minor = ($info['rdev'] & 0xff) | (($info['rdev'] >> 12) & 0xfff00);
    return "dm-$minor";
}

/** Turn the \040 style escapes used in /proc/mounts back into characters. */
function unescape_mount_field(string $field): string
{
    return preg_replace_callback(
        '/\\\\([0-7]{3})/',
        function (array $m): string {
            return chr(octdec($m[1]));
        },
        $field
    );
}

/**
 * Read the system's mount table. Returns, per kernel device name ("dm-3"),
 * where it is mounted, with which filesystem and whether read-only.
 */
function read_mounts(): array
{
    $mounts = [];
    $lines = @file('/proc/mounts', FILE_IGNORE_NEW_LINES);
    foreach ($lines === false ? [] : $lines as $line) {
        $fields = explode(' ', $line);
        if (count($fields) < 4) {
            continue;
        }
        $device = unescape_mount_field($fields[0]);
        if (strncmp($device, '/dev/mapper/', 12) !== 0 && strncmp($device, '/dev/dm-', 8) !== 0) {
            continue;
        }
        $dm = dm_name($device);
        if ($dm === null || isset($mounts[$dm])) {
            continue;
        }
        $mounts[$dm] = [
            'point' => unescape_mount_field($fields[1]),
            // The kernel's names for the two NTFS drivers are "ntfs3" and "fuseblk".
            'filesystem' => in_array($fields[2], ['ntfs3', 'fuseblk'], true) ? 'ntfs' : $fields[2],
            'read_only' => in_array('ro', explode(',', $fields[3]), true),
        ];
    }
    return $mounts;
}

/** The volume file behind an unlocked device, as the kernel reports it. */
function backing_file(string $dm): ?string
{
    $slaves = glob("/sys/block/$dm/slaves/*");
    if ($slaves === false || count($slaves) !== 1) {
        return null;
    }
    $loop = basename($slaves[0]);
    $file = @file_get_contents("/sys/block/$loop/loop/backing_file");
    return $file === false ? null : rtrim($file, "\n");
}

/**
 * Look at the live system: which of our volumes are unlocked or mounted now.
 * Returns a list indexed by volume name. Nothing is read from a state file.
 */
function live_volumes(): array
{
    $mounts = read_mounts();
    $live = [];
    $devices = glob(MAPPER_DIR . '/' . MAPPER_PREFIX . '*');
    foreach ($devices === false ? [] : $devices as $device) {
        $name = substr(basename($device), strlen(MAPPER_PREFIX));
        if (!preg_match(NAME_PATTERN, $name)) {
            continue;
        }
        $dm = dm_name($device);
        $mount = $dm === null ? null : ($mounts[$dm] ?? null);
        $live[$name] = [
            'dm' => $dm,
            'file' => $dm === null ? null : backing_file($dm),
            'mounted_at' => $mount['point'] ?? null,
            'filesystem' => $mount['filesystem'] ?? null,
            'read_only' => $mount['read_only'] ?? null,
        ];
    }
    return $live;
}

/** Put the saved settings and the live state of one volume together. */
function describe(string $name, ?array $saved, ?array $live): array
{
    $mounted_at = $live['mounted_at'] ?? null;
    if ($live === null) {
        $state = 'locked';
    } elseif ($mounted_at === null) {
        $state = 'unlocked';
    } else {
        $state = 'mounted';
    }

    $size = $mounted_at === null ? false : @disk_total_space($mounted_at);
    $free = $mounted_at === null ? false : @disk_free_space($mounted_at);

    return [
        'name' => $name,
        'display_name' => $saved['display_name'] ?? $name,
        'saved' => $saved !== null,
        'state' => $state,
        'file' => $saved['file'] ?? ($live['file'] ?? null),
        'mounted_at' => $mounted_at,
        'mount_at' => $saved['mount_at'] ?? null,
        'filesystem' => $live['filesystem'] ?? null,
        'read_only' => $live['read_only'] ?? ($saved['read_only'] ?? false),
        'size_bytes' => $size === false ? null : (int) $size,
        'free_bytes' => $free === false ? null : (int) $free,
        'share' => $saved['share'] ?? null,
        // What the mount dialog has to ask for. Keyfile paths are not secret.
        'pim' => $saved['pim'] ?? false,
        'keyfiles' => $saved['keyfiles'] ?? [],
        'hidden' => $saved['hidden'] ?? false,
        'dependents' => array_column($saved['dependents'] ?? [], 'container'),
        'share_active' => share_active($name),
        // LIFE-8: the idle lock time in minutes (null when off) and, for a
        // mounted volume, as the last idle check saw it: the whole minutes
        // left (null if not looked at yet) and whether something still holds
        // it although its time is up. Minutes, so the list changes only once
        // a minute and the pages are not drawn again every few seconds.
        'idle_lock' => $saved['idle_lock'] ?? null,
    ] + idle_view($name, $state === 'mounted' ? ($saved['idle_lock'] ?? null) : null, $live['dm'] ?? null);
}

/** All volumes: the saved ones first, then anything mounted without saving. */
function all_volumes(): array
{
    $saved = load_config();
    $live = live_volumes();
    $result = [];
    foreach ($saved as $name => $volume) {
        $result[] = describe($name, $volume, $live[$name] ?? null);
    }
    foreach ($live as $name => $state) {
        if (!isset($saved[$name])) {
            $result[] = describe($name, null, $state);
        }
    }
    return $result;
}

function format_size(?int $bytes): string
{
    if ($bytes === null) {
        return '-';
    }
    if ($bytes < 1e9) {
        return sprintf('%d MB', round($bytes / 1e6));
    }
    return $bytes < 1e12 ? sprintf('%.1f GB', $bytes / 1e9) : sprintf('%.1f TB', $bytes / 1e12);
}

function command_list(bool $json): int
{
    $volumes = all_volumes();
    if ($json) {
        $settings = [];
        foreach (SETTINGS as $key => $default) {
            $settings[$key] = setting($key, $default);
        }
        echo json_encode(['ok' => true, 'volumes' => $volumes, 'settings' => $settings], JSON_UNESCAPED_SLASHES), "\n";
        return CODE_OK;
    }
    if ($volumes === []) {
        echo "No volumes are saved and none is mounted.\n";
        return CODE_OK;
    }
    printf("%-24s %-9s %-28s %s\n", 'NAME', 'STATE', 'MOUNTED AT', 'VOLUME FILE');
    foreach ($volumes as $v) {
        $name = $v['name'] . ($v['saved'] ? '' : ' (not saved)');
        printf("%-24s %-9s %-28s %s\n", $name, $v['state'], $v['mounted_at'] ?? '-', $v['file'] ?? '-');
    }
    return CODE_OK;
}

/**
 * For a mounted saved volume, what a mount answer would have warned about, in
 * the same fields: a share that is not open, dependents that are not running,
 * and a top folder the share cannot write to. The web page uses it when the
 * mount's own answer was lost (audit B8). Empty for any other volume.
 */
function mount_problems(string $name, ?array $saved, array $v): array
{
    if ($saved === null || $v['state'] !== 'mounted') {
        return [];
    }
    $share_error = $saved['share'] !== null && !$v['share_active']
        ? 'Its share is not open. Dismount it and mount it again, or see the system log.' : null;
    $failed = [];
    if ($saved['dependents'] !== []) {
        $ready = docker_ready();
        foreach ($saved['dependents'] as $dependent) {
            $running = $ready ? container_running($dependent['container']) : false;
            if ($running !== true) {
                $failed[] = ['container' => $dependent['container'],
                             'reason' => !$ready ? 'the Docker service is not running'
                                       : ($running === null ? 'there is no such container' : 'it is not running')];
            }
        }
    }
    return ['share_error' => $share_error, 'failed_dependents' => $failed,
            'top_folder_blocked' => $share_error === null && top_folder_blocked($name, $saved)];
}

function command_status(array $args, bool $json): int
{
    if (count($args) !== 1) {
        throw new Fail("Usage: vcmount status <name>", CODE_USAGE);
    }
    $name = $args[0];
    if (!preg_match(NAME_PATTERN, $name)) {
        throw new Fail('That is not a valid volume name.', CODE_USAGE);
    }
    $saved = load_config()[$name] ?? null;
    $live = live_volumes()[$name] ?? null;
    if ($saved === null && $live === null) {
        throw new Fail("There is no volume named \"$name\".", CODE_USAGE);
    }
    $v = describe($name, $saved, $live);

    if ($json) {
        echo json_encode(['ok' => true, 'volume' => $v] + mount_problems($name, $saved, $v), JSON_UNESCAPED_SLASHES), "\n";
        return CODE_OK;
    }
    echo 'Name:        ', $v['name'], $v['saved'] ? '' : ' (not saved)', "\n";
    echo 'State:       ', $v['state'], "\n";
    echo 'Volume file: ', $v['file'] ?? '-', "\n";
    echo 'Mounted at:  ', $v['mounted_at'] ?? '-', "\n";
    echo 'Read-only:   ', $v['read_only'] ? 'yes' : 'no', "\n";
    if ($v['state'] === 'mounted') {
        echo 'Size:        ', format_size($v['size_bytes']), "\n";
        echo 'Free:        ', format_size($v['free_bytes']), "\n";
    }
    if (($saved['share'] ?? null) !== null) {
        $share = $saved['share'];
        $how = [];
        foreach ($share['users'] as $user => $access) {
            $how[] = "$user " . ($v['read_only'] ? 'read-only' : $access);
        }
        if ($share['export'] === 'hidden') {
            $how[] = 'hidden';
        }
        echo 'Share:       \\\\', php_uname('n'), '\\', $name, ' (', implode(', ', $how), ')',
            $v['share_active'] ? '' : ' - not active', "\n";
    }
    foreach ($saved['dependents'] ?? [] as $dependent) {
        $running = docker_ready() ? container_running($dependent['container']) : false;
        $state = $running === null ? 'does not exist' : ($running ? 'running' : 'stopped');
        echo 'Dependent:   ', $dependent['container'], " ($state)\n";
    }
    return CODE_OK;
}

/**
 * Print the result of a successful dismount. $notes says what else happened
 * on the way, for example that a dependent was killed.
 */
function report(bool $json, string $name, string $text, array $notes = []): void
{
    if ($json) {
        $v = describe($name, load_config()[$name] ?? null, live_volumes()[$name] ?? null);
        echo json_encode(['ok' => true, 'volume' => $v, 'notes' => $notes], JSON_UNESCAPED_SLASHES), "\n";
    } else {
        foreach ($notes as $note) {
            echo $note, "\n";
        }
        echo $text, "\n";
    }
}

/**
 * Write one line to the system log. Events only: never a password, never a
 * file name from inside a volume. Callers do not log volumes that are not saved.
 */
function log_event(string $message, bool $notify = false, string $level = 'warning'): void
{
    // Unless the setting "Show volume names in logs" is on, every name is left
    // out. Messages put every volume and container name in double quotes, so
    // this catches them all. The system log is copied to the flash drive at
    // shutdown and goes into diagnostics; notifications are archived there too.
    $names = false;
    try {
        $names = setting('log_names', SETTINGS['log_names']);
    } catch (Throwable $e) {
        // A settings file that cannot be read must not stop the log line.
    }
    if (!$names) {
        $message = preg_replace('/"[^"]*"/', '(name hidden)', $message);
    }
    openlog('veracrypt.mount', 0, LOG_USER);
    syslog(LOG_INFO, $message);
    closelog();

    // Faults also go to Unraid's notifications (LIFE-9), with the same text.
    if ($notify && is_executable(NOTIFY_SCRIPT)) {
        try {
            run([NOTIFY_SCRIPT, '-e', 'VeraCrypt Mount', '-s', 'VeraCrypt Mount', '-d', $message, '-i', $level], 20);
        } catch (Fail $e) {
            // A notification that cannot be sent must not stop a dismount.
        }
    }
}

/** The full path of a system program, looked up in the system folders only. */
function program(string $name): string
{
    foreach (['/sbin', '/usr/sbin', '/bin', '/usr/bin'] as $dir) {
        if (is_executable("$dir/$name")) {
            return "$dir/$name";
        }
    }
    throw new Fail("The program $name was not found on this server.", CODE_USAGE);
}

/**
 * Start one program and wait for it, with a time limit.
 *
 * The program is started directly from a list of arguments. No shell is
 * involved, so nothing in the arguments can be misread as a command.
 *
 * $stdin: what the program gets as standard input. Default: nothing.
 * $show_errors: let the program write its error messages straight to the user.
 */
function run(array $command, int $timeout, $stdin = null, bool $show_errors = false,
             bool $cancellable = false, ?string $cancel_token = null): array
{
    // Ctrl+C, a closed terminal or a stop signal also reach cryptsetup, which
    // ignores them until its key derivation ends. Catch them here instead and
    // end the child below (UI-8). Installed before the child starts, so there
    // is no moment in which a signal ends only this program; put back as they
    // were on every way out.
    $stop = false;
    $previous = [];
    if ($cancellable) {
        pcntl_async_signals(true);
        // With SIGCHLD ignored the system would collect the child itself and
        // could hand its process number to another program.
        $previous[SIGCHLD] = pcntl_signal_get_handler(SIGCHLD);
        pcntl_signal(SIGCHLD, SIG_DFL);
        foreach ([SIGINT, SIGTERM, SIGHUP] as $signal) {
            $previous[$signal] = pcntl_signal_get_handler($signal);
            pcntl_signal($signal, function () use (&$stop) { $stop = true; });
        }
    }
    try {
        return run_watched($command, $timeout, $stdin, $show_errors, $cancellable, $stop, $cancel_token);
    } finally {
        foreach ($previous as $signal => $handler) {
            pcntl_signal($signal, $handler);
        }
    }
}

/** The body of run(); $stop is set by run()'s signal handlers. */
function run_watched(array $command, int $timeout, $stdin, bool $show_errors,
                     bool $cancellable, bool &$stop, ?string $cancel_token): array
{
    $spec = [
        0 => $stdin ?? ['file', '/dev/null', 'r'],
        1 => ['pipe', 'w'],
        2 => $show_errors ? STDERR : ['pipe', 'w'],
    ];
    $process = proc_open($command, $spec, $pipes);
    if (!is_resource($process)) {
        throw new Fail("Could not start {$command[0]}.", CODE_USAGE);
    }

    $open = $pipes;
    $text = [1 => '', 2 => ''];
    foreach ($open as $pipe) {
        stream_set_blocking($pipe, false);
    }
    $deadline = microtime(true) + $timeout;
    $timed_out = false;
    $cancelled = false;

    while ($open !== []) {
        $left = $deadline - microtime(true);
        if ($left <= 0) {
            $timed_out = true;
            proc_terminate($process);
            break;
        }
        if ($cancellable && ($stop || ($cancel_token !== null && cancel_matches($cancel_token)))) {
            // Our own child, not yet collected, so its process number cannot
            // belong to another program. cryptsetup writes nothing before the
            // password is right, so ending it at once is safe.
            $cancelled = true;
            proc_terminate($process, 9);
            break;
        }
        $read = array_values($open);
        $write = null;
        $except = null;
        $ready = $cancellable
            ? @stream_select($read, $write, $except, 0, (int) min($left * 1e6, CANCEL_POLL))
            : @stream_select($read, $write, $except, (int) ceil($left));
        if ($ready === false) {
            // Interrupted by a signal, or a passing fault: look again. Giving
            // up here would leave proc_close() waiting with no time limit; the
            // deadline still ends the loop.
            usleep(50000);
            continue;
        }
        foreach ($read as $pipe) {
            $key = array_search($pipe, $open, true);
            $chunk = fread($pipe, 8192);
            if ($chunk !== false && $chunk !== '') {
                $text[$key] .= $chunk;
            } elseif (feof($pipe)) {
                fclose($pipe);
                unset($open[$key]);
            }
        }
    }
    foreach ($open as $pipe) {
        fclose($pipe);
    }
    if ($timed_out) {
        // cryptsetup notices SIGTERM only after its current key derivation,
        // which with a large PIM takes hours. After a short wait, end it.
        $until = microtime(true) + KILL_GRACE;
        while (proc_get_status($process)['running'] && microtime(true) < $until) {
            usleep(100000);
        }
        if (proc_get_status($process)['running']) {
            proc_terminate($process, 9);
        }
    }
    $code = proc_close($process);

    return [
        'code' => ($timed_out || $cancelled) ? -1 : $code,
        'out' => $text[1],
        'err' => $text[2],
        'timed_out' => $timed_out,
        'cancelled' => $cancelled,
    ];
}

/** Is the Docker service running? Asked once per run. */
function docker_ready(): bool
{
    static $ready = null;
    if ($ready === null) {
        try {
            $r = run([program('docker'), 'version', '--format', '{{.Server.Version}}'], TOOL_TIMEOUT);
            $ready = $r['code'] === 0;
        } catch (Fail $e) {
            $ready = false;
        }
    }
    return $ready;
}

/** Is this container running? Returns null if there is no such container. */
function container_running(string $container): ?bool
{
    $r = run(
        [program('docker'), 'inspect', '--type', 'container', '--format', '{{.State.Running}}', $container],
        TOOL_TIMEOUT
    );
    return $r['code'] !== 0 ? null : trim($r['out']) === 'true';
}

/** The exit code of a stopped container, or null if it cannot be read. */
function container_exit_code(string $container): ?int
{
    $r = run(
        [program('docker'), 'inspect', '--type', 'container', '--format', '{{.State.ExitCode}}', $container],
        TOOL_TIMEOUT
    );
    $out = trim($r['out']);
    return $r['code'] === 0 && preg_match('/\A-?[0-9]{1,4}\z/', $out) ? (int) $out : null;
}

/** Unraid's list of containers to start with Docker: one name per line, optionally a wait. */
const AUTOSTART_FILE = '/var/lib/docker/unraid-autostart';

/**
 * DOC-7: which of these containers start by themselves, through Unraid's
 * autostart or a Docker restart policy. A dependent among them can start
 * before its volume is mounted and then writes into an empty folder in RAM.
 * Returns name => ['autostart' => bool, 'restart' => the policy or ''].
 */
function starts_alone(array $containers): array
{
    $found = [];
    if ($containers === []) {
        return $found;
    }
    foreach (@file(AUTOSTART_FILE, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
        $name = preg_split('/\s+/', trim($line))[0];
        if (in_array($name, $containers, true)) {
            $found[$name] = ['autostart' => true, 'restart' => ''];
        }
    }
    // Names cannot start with a dash (CONTAINER_PATTERN), so none is read as an option.
    $r = run(array_merge([program('docker'), 'inspect', '--type', 'container', '--format',
                          '{{.Name}} {{.HostConfig.RestartPolicy.Name}}'], $containers), TOOL_TIMEOUT);
    foreach (preg_split('/\n/', trim($r['out'])) as $line) {
        if (preg_match('#\A/(\S+) (always|unless-stopped)\z#', trim($line), $m) && in_array($m[1], $containers, true)) {
            $found[$m[1]] = ['autostart' => $found[$m[1]]['autostart'] ?? false, 'restart' => $m[2]];
        }
    }
    return $found;
}

/**
 * Start the dependents of a volume in list order (DOC-3). One that fails does
 * not hold back the others. Returns the failures, each with its reason.
 */
function start_dependents(string $volume, array $dependents): array
{
    $failed = [];
    $last = count($dependents) - 1;
    foreach ($dependents as $i => $dependent) {
        // Docker or the array is being stopped: start nothing more (audit
        // 2026-11-27c S1); the hooks stop what runs.
        if (stop_requested()) {
            break;
        }
        $container = $dependent['container'];
        $reason = null;
        if (!docker_ready()) {
            $reason = 'the Docker service is not running';
        } else {
            $running = container_running($container);
            if ($running === null) {
                $reason = 'there is no container with this name';
            } elseif (!$running) {
                $r = run([program('docker'), 'start', $container], TOOL_TIMEOUT);
                if ($r['code'] !== 0) {
                    $reason = $r['timed_out'] ? 'starting it took too long' : trim($r['err']);
                }
            }
        }
        if ($reason !== null) {
            $failed[] = ['container' => $container, 'reason' => $reason];
            log_event("dependent \"$container\" of \"$volume\" could not be started", true);
        } elseif ($dependent['delay'] > 0 && $i < $last && !pause($dependent['delay'])) {
            break;
        }
    }
    return $failed;
}

/**
 * Stop the dependents of a volume in reverse list order (DOC-4). Each gets its
 * grace period; "docker stop" kills what has not stopped by then (DOC-5).
 * Returns, per dependent that was running: container, result (stopped, killed
 * or failed) and a message.
 */
/*
 * Array stop and shutdown (audit S2), and finishing a mount after a signal
 * (review C5). The hooks say how many seconds they have (--within); the engine
 * then shares that time out instead of being cut off half-way. A stop signal
 * only asks: the volume being worked on is finished or rolled back cleanly.
 */
$GLOBALS['vcm_deadline'] = null;   // microtime() by which to be done, or null
$GLOBALS['vcm_stop'] = false;      // a stop signal arrived
$GLOBALS['vcm_started'] = time();  // when this run began

/**
 * Should a long action give way: a stop signal, or a stop of the array or of
 * Docker asked for by a hook since this run began (audit 2026-11-27c S1)?
 */
function stop_requested(): bool
{
    if ($GLOBALS['vcm_stop']) {
        return true;
    }
    $asked = read_marker(STOP_FILE);
    return $asked !== null && preg_match('/\A[0-9]+\z/', trim($asked)) === 1
        && (int) trim($asked) >= $GLOBALS['vcm_started'];
}

/** Wait, one second at a time; false if a stop was asked for meanwhile. */
function pause(int $seconds): bool
{
    for ($i = 0; $i < $seconds; $i++) {
        if (stop_requested()) {
            return false;
        }
        sleep(1);
    }
    return !stop_requested();
}

/**
 * Catch stop signals so they are only noted in $GLOBALS['vcm_stop'] instead of
 * ending the engine mid-way (audit S2, review C5). Returns the previous
 * handlers so the caller can put them back with restore_signals().
 */
function defer_signals(): array
{
    $previous = [];
    pcntl_async_signals(true);
    foreach ([SIGINT, SIGTERM, SIGHUP] as $signal) {
        $previous[$signal] = pcntl_signal_get_handler($signal);
        pcntl_signal($signal, function () { $GLOBALS['vcm_stop'] = true; });
    }
    return $previous;
}

/** Put back the signal handlers saved by defer_signals(). */
function restore_signals(array $previous): void
{
    foreach ($previous as $signal => $handler) {
        pcntl_signal($signal, $handler);
    }
}

/** Take the time limit from --within and catch stop signals from now on. */
function watch_time(array $options): void
{
    if ($options['within'] !== null) {
        if (!preg_match('/\A[1-9][0-9]{0,3}\z/', $options['within'])) {
            throw new Fail('--within needs a number of seconds from 1 to 9999.', CODE_USAGE);
        }
        $GLOBALS['vcm_deadline'] = microtime(true) + (int) $options['within'];
    }
    defer_signals();
}

/** Seconds left before the deadline, or null without one. */
function time_left(): ?float
{
    return $GLOBALS['vcm_deadline'] === null ? null : $GLOBALS['vcm_deadline'] - microtime(true);
}

/** Should the next volume or dependent be left alone? */
function out_of_time(float $needs = 3): bool
{
    $left = time_left();
    return $GLOBALS['vcm_stop'] || ($left !== null && $left < $needs);
}

/** A wait in seconds, shortened to fit the time left, but at least 1. */
function fitting(int $seconds, float $margin = 3): int
{
    $left = time_left();
    return $left === null ? $seconds : max(1, min($seconds, (int) floor($left - $margin)));
}

function stop_dependents(string $volume, array $dependents): array
{
    $results = [];
    if ($dependents === [] || !docker_ready()) {
        return $results;   // without the Docker service no container is running
    }
    foreach (array_reverse($dependents) as $dependent) {
        $container = $dependent['container'];
        if (!container_running($container)) {
            continue;
        }
        if (out_of_time()) {
            $results[] = ['container' => $container, 'result' => 'failed',
                          'message' => "Dependent \"$container\" was left running: no time was left."];
            log_event("dependent \"$container\" of \"$volume\" was left to Unraid: no time was left", true);
            continue;
        }
        $grace = fitting($dependent['grace']);
        $begin = microtime(true);
        run([program('docker'), 'stop', '-t', (string) $grace, $container], $grace + 30);
        $took = microtime(true) - $begin;

        // Killed only if Docker had to end it: exit code 137 is SIGKILL. The
        // time alone misleads: a clean stop just inside the grace period plus
        // Docker's own overhead also reaches it (audit B12). If the code
        // cannot be read, fall back to the time.
        $exit = container_exit_code($container);
        if (container_running($container)) {
            $result = 'failed';
            $message = "Dependent \"$container\" could not be stopped.";
            log_event("dependent \"$container\" of \"$volume\" could not be stopped", true);
        } elseif ($exit === null ? $took >= $grace : $exit === 137) {
            $result = 'killed';
            $message = "Dependent \"$container\" did not stop within $grace seconds and was killed.";
            log_event("dependent \"$container\" of \"$volume\" did not stop within $grace seconds and was killed", true);
        } else {
            $result = 'stopped';
            $message = "Stopped dependent \"$container\".";
        }
        $results[] = ['container' => $container, 'result' => $result, 'message' => $message];
    }
    return $results;
}

/** The file that holds the Samba settings of one share. */
function share_file(string $name): string
{
    return SHARE_DIR . "/$name.conf";
}

/** The line in SMB_HOOK that makes Samba read one share file. */
function include_line(string $name): string
{
    return 'include = ' . share_file($name);
}

/** The lines of SMB_HOOK, without line ends. A missing file has none. */
function hook_lines(): array
{
    $lines = @file(SMB_HOOK, FILE_IGNORE_NEW_LINES);
    return $lines === false ? [] : $lines;
}

/**
 * Write SMB_HOOK again with these lines. Written to a temporary file first and
 * then renamed over the original, so the file is never half written.
 */
function write_hook(array $lines): void
{
    $temp = SMB_HOOK . '.vcmount-new';
    $text = $lines === [] ? '' : implode("\n", $lines) . "\n";
    if (@file_put_contents($temp, $text) === false || !@chmod($temp, 0644) || !@rename($temp, SMB_HOOK)) {
        @unlink($temp);
        throw new Fail('Could not write ' . SMB_HOOK . '.', CODE_SHARE);
    }
}

/** Is the include line of this share in SMB_HOOK? */
function hook_has(string $name): bool
{
    return in_array(include_line($name), array_map('trim', hook_lines()), true);
}

/** Add the include line of this share to SMB_HOOK, unless it is there. */
function hook_add(string $name): void
{
    if (!hook_has($name)) {
        $lines = hook_lines();
        $lines[] = include_line($name);
        write_hook($lines);
    }
}

/** Remove the include line of this share from SMB_HOOK. Touches no other line. */
function hook_remove(string $name): void
{
    $lines = hook_lines();
    $kept = array_values(array_filter($lines, function (string $line) use ($name): bool {
        return trim($line) !== include_line($name);
    }));
    if (count($kept) !== count($lines)) {
        write_hook($kept);
    }
}

/** Tell the running Samba to read its settings again. Returns whether it worked. */
function samba_reload(): bool
{
    try {
        return run([program('smbcontrol'), 'all', 'reload-config'], TOOL_TIMEOUT)['code'] === 0;
    } catch (Fail $e) {
        return false;
    }
}

/** Is SMB turned on in Unraid's settings? Unknown counts as yes. */
function smb_enabled(): bool
{
    $vars = @parse_ini_file(UNRAID_VARS);
    return !is_array($vars) || ($vars['shareSMBEnabled'] ?? 'yes') !== 'no';
}

/** Does this user exist on the server? Read from /etc/passwd. */
function user_exists(string $user): bool
{
    $lines = @file('/etc/passwd', FILE_IGNORE_NEW_LINES);
    foreach ($lines === false ? [] : $lines as $line) {
        $fields = explode(':', $line);
        // Only the users Unraid creates (user IDs 1000 and up), as the page
        // offers them; never root, nobody or a system account (audit
        // 2026-11-27c S5).
        if ($fields[0] === $user) {
            $uid = (int) ($fields[2] ?? -1);
            return $uid >= 1000 && $uid < 60000;
        }
    }
    return false;
}

/**
 * The names of all shares Samba knows now, in lower case (Samba ignores case).
 * Read with testparm, which follows every include file.
 */
function samba_share_names(): array
{
    $r = run([program('testparm'), '-s'], TOOL_TIMEOUT);
    if ($r['code'] !== 0) {
        throw new Fail('Could not read the Samba settings (testparm failed).', CODE_SHARE);
    }
    preg_match_all('/^\[([^\]\n]+)\]\s*$/m', $r['out'], $m);
    return array_map('strtolower', $m[1]);
}

/** The text of one share file (docs/DESIGN-engine.md, section 9b). */
function share_text(string $name, array $share, string $point, bool $read_only): string
{
    // As Unraid's "Private" shares: everyone listed may read, the read-write
    // users may also write. A volume mounted read-only gives nobody write access.
    $writers = array_keys(array_filter($share['users'], function (string $access): bool {
        return $access === 'read-write';
    }));
    return "[$name]\n"
        . "\tpath = $point\n"
        . "\tcomment = VeraCrypt volume\n"
        . "\tbrowseable = " . ($share['export'] === 'hidden' ? 'no' : 'yes') . "\n"
        . "\tguest ok = no\n"
        // Links inside the volume never lead out of it, whatever Samba's
        // global settings say (audit S9).
        . "\twide links = no\n"
        . "\tvalid users = " . implode(' ', array_keys($share['users'])) . "\n"
        . "\tread only = yes\n"
        . ($read_only || $writers === [] ? '' : "\twrite list = " . implode(' ', $writers) . "\n")
        . "\tforce user = nobody\n"
        . "\tforce group = users\n"
        . "\tcreate mask = 0666\n"
        . "\tdirectory mask = 0777\n"
        // As Unassigned Devices does: whatever Samba reads next is not part of this share.
        . "\n[global]\n";
}

/** Is the share of this volume in place: its file and its include line? */
function share_active(string $name): bool
{
    return is_file(share_file($name)) && hook_has($name);
}

/**
 * Add the SMB share of a mounted volume, or write it again. On a refusal
 * nothing is written. Throws Fail with CODE_SHARE.
 */
function add_share(string $name, array $share, string $point, bool $read_only): void
{
    // Samba gives these section names a special meaning (audit S9).
    if (in_array(strtolower($name), RESERVED_SHARES, true)) {
        throw new Fail("No share for \"$name\": Samba reserves that name. Rename the volume to share it.", CODE_SHARE);
    }
    if (!smb_enabled()) {
        throw new Fail("No share for \"$name\": SMB is turned off in Unraid's settings.", CODE_SHARE);
    }
    foreach (array_keys($share['users']) as $user) {
        if (!user_exists($user)) {
            throw new Fail("No share for \"$name\": there is no user named \"$user\" on this server.", CODE_SHARE);
        }
    }
    // Samba reads % as a placeholder and cannot take a line break in a path.
    if (preg_match('/[\x00-\x1f%]/', $point)) {
        throw new Fail("No share for \"$name\": its mount location contains characters Samba cannot use.", CODE_SHARE);
    }
    $file = share_file($name);
    if (!is_file($file) && in_array(strtolower($name), samba_share_names(), true)) {
        throw new Fail("No share for \"$name\": another share already has this name.", CODE_SHARE);
    }

    if (!is_dir(SHARE_DIR) && !@mkdir(SHARE_DIR, 0755)) {
        throw new Fail('Could not create ' . SHARE_DIR . '.', CODE_SHARE);
    }
    if (@file_put_contents($file, share_text($name, $share, $point, $read_only)) === false) {
        throw new Fail("Could not write $file.", CODE_SHARE);
    }
    @chmod($file, 0644);
    try {
        hook_add($name);
    } catch (Fail $e) {
        @unlink($file);
        throw $e;
    }
    if (!samba_reload()) {
        // Take the share back out, so the page does not show it as on and the
        // next Samba reload does not open it unasked (audit B4).
        @unlink($file);
        try {
            hook_remove($name);
        } catch (Fail $e) {
            // Reported below in the same message.
        }
        throw new Fail("No share for \"$name\": Samba did not take it up (smbcontrol failed), so it was removed again.", CODE_SHARE);
    }
}

/**
 * Remove the SMB share of a volume, if there is one: settings first, then
 * disconnect the clients that are still connected. Never throws; returns notes
 * on what did not work, for the caller to report.
 */
function remove_share(string $name): array
{
    $file = share_file($name);
    if (!is_file($file) && !hook_has($name)) {
        return [];
    }
    $notes = [];
    if (is_file($file) && !@unlink($file)) {
        $notes[] = "Could not delete $file.";
    }
    try {
        hook_remove($name);
    } catch (Fail $e) {
        $notes[] = $e->getMessage();
    }
    // Without a running Samba (for example at array stop) there is nobody to tell.
    if (!samba_running()) {
        return $notes;
    }
    if (!samba_reload()) {
        $notes[] = "Samba did not take up the removal of the share \"$name\" (smbcontrol failed).";
    }
    try {
        run([program('smbcontrol'), 'all', 'close-share', $name], TOOL_TIMEOUT);
    } catch (Fail $e) {
        $notes[] = $e->getMessage();
    }
    return $notes;
}

/** Is Samba running? If that cannot be found out, the answer is yes. */
function samba_running(): bool
{
    try {
        return run([program('pgrep'), '-x', 'smbd'], TOOL_TIMEOUT)['code'] === 0;
    } catch (Fail $e) {
        return true;
    }
}

/**
 * Is this volume file open from the network right now (VOL-7)? Asks Samba for
 * its list of open files. Returns a short description of who has it open, or
 * null. Throws Fail (refused) when Samba runs but cannot be asked.
 */
function network_open(string $file): ?string
{
    try {
        $r = run([program('smbstatus'), '-L', '--json'], TOOL_TIMEOUT);
    } catch (Fail $e) {
        return null;   // no Samba on this server, so no network client
    }
    $data = $r['code'] === 0 ? json_decode($r['out'], true) : null;
    if (!is_array($data)) {
        // Samba not running means no network client. Otherwise refuse.
        if (!samba_running()) {
            return null;
        }
        throw new Fail('Refused: could not ask Samba whether a network client has the volume file open.', CODE_REFUSED);
    }
    foreach ($data['open_files'] ?? [] as $key => $open) {
        $path = (string) $key;
        if (is_array($open) && isset($open['service_path'], $open['filename'])) {
            $path = rtrim((string) $open['service_path'], '/') . '/' . ltrim((string) $open['filename'], '/');
        }
        if (same_file($path, $file)) {
            $users = [];
            foreach (is_array($open['opens'] ?? null) ? $open['opens'] : [] as $entry) {
                if (is_array($entry) && isset($entry['username'])) {
                    $users[] = (string) $entry['username'];
                }
            }
            return $users === [] ? 'a network client' : 'network user ' . implode(', ', array_unique($users));
        }
    }
    return null;
}

/**
 * Make sure only one vcmount action that changes something runs at a time.
 * A second one stops at once instead of waiting.
 */
function take_lock()
{
    ensure_run_dir();
    if (is_link(LOCK_FILE)) {
        throw new Fail('Refused: ' . LOCK_FILE . ' is a link.', CODE_REFUSED);
    }
    // 'e': programs this one starts do not inherit the lock, so a helper left
    // running after this program was ended cannot keep it (audit S2).
    $handle = @fopen(LOCK_FILE, 'ce');
    if ($handle === false) {
        throw new Fail('Could not create the lock file ' . LOCK_FILE . '.', CODE_USAGE);
    }
    @chmod(LOCK_FILE, 0600);
    if (!flock($handle, LOCK_EX | LOCK_NB)) {
        fclose($handle);
        throw new Fail('Another vcmount action is still running.', CODE_IN_PROGRESS);
    }
    return $handle;
}

/** Every place where something is mounted right now. */
function mount_points(): array
{
    $points = [];
    $lines = @file('/proc/mounts', FILE_IGNORE_NEW_LINES);
    foreach ($lines === false ? [] : $lines as $line) {
        $fields = explode(' ', $line);
        if (count($fields) >= 2) {
            $points[] = unescape_mount_field($fields[1]);
        }
    }
    return $points;
}

/**
 * Is this volume file already in use as a device on the server?
 * Returns the device name ("loop3") or null.
 *
 * On Unraid the same file is reachable as /mnt/user/<share>/... and as
 * /mnt/<disk or pool>/<share>/.... Both count as the same file here. That can
 * refuse a mount that would have been safe, never the other way round.
 */
function file_in_use(string $file): ?string
{
    $paths = glob('/sys/block/loop*/loop/backing_file');
    foreach ($paths === false ? [] : $paths as $path) {
        $backing = rtrim((string) @file_get_contents($path), "\n");
        if ($backing !== '' && same_file($backing, $file)) {
            return basename(dirname($path, 2));
        }
    }
    return null;
}

/**
 * Are these two paths the same file? /mnt/user/<share>/x and /mnt/<disk>/<share>/x
 * count as the same (see file_in_use).
 */
function same_file(string $one, string $two): bool
{
    if ($one === $two) {
        return true;
    }
    $pattern = '#\A/mnt/([^/]+)/(.+)\z#';
    if (!preg_match($pattern, $one, $a) || !preg_match($pattern, $two, $b)) {
        return false;
    }
    $through_user_share = in_array($a[1], ['user', 'user0'], true) || in_array($b[1], ['user', 'user0'], true);
    return $through_user_share && $a[2] === $b[2];
}

/**
 * Is this a plain path below /mnt/: absolute, no empty, "." or ".." parts, no
 * trailing slash, no control characters, not too long? Used for volume files,
 * keyfiles and mount locations (audit S1, S3, B17.1).
 */
function plain_mnt_path(string $path): bool
{
    return str_starts_with($path, '/mnt/') && strlen($path) <= 4096
        && !str_ends_with($path, '/') && strpos($path, '//') === false
        && !preg_match('#/\.\.?(/|\z)#', $path) && !preg_match('/[\x00-\x1f\x7f]/', $path);
}

/**
 * Is this a valid mount location? Either under /mnt/addons/ (MNT-1, default
 * /mnt/addons/<name>) or a folder inside an Unraid user share
 * (/mnt/user/<share>/<folder>, MNT-2). No trailing slash, "..", control
 * characters, "\" or "%" (audit S1, S9, B17.1).
 */
function valid_mount_at(string $point): bool
{
    return plain_mnt_path($point)
        && strpbrk($point, '\%') === false
        // No space at the start or end of a folder name: Samba would cut it
        // off and share another folder (audit 2026-11-27c S5).
        && preg_match('#(\A|/)\s|\s(/|\z)#', $point) !== 1
        && (preg_match('#\A/mnt/addons/[^/]+#', $point) === 1
            || preg_match('#\A/mnt/user/[^/]+/[^/]+#', $point) === 1);
}

/** Refuse a mount point that is not safe to use. Creates nothing. */
function check_mount_point(string $point): void
{
    // Asked again after a slow unlock: never from PHP's cache (audit 2026-11-27c S5).
    clearstatcache(true);
    if (!valid_mount_at($point)) {
        throw new Fail("The mount location $point is not valid. It must be under /mnt/addons/ or a folder inside a share under /mnt/user/<share>/.", CODE_USAGE);
    }
    // A folder inside a share needs the share: creating /mnt/user/<x> would
    // make a new Unraid share, for example from a typing error (audit
    // 2026-11-27c S5).
    if (preg_match('#\A/mnt/user/([^/]+)/#', $point, $m)
        && (!is_dir("/mnt/user/{$m[1]}") || is_link("/mnt/user/{$m[1]}"))) {
        throw new Fail("The mount location $point is not valid: there is no share \"{$m[1]}\". Create it in Unraid first, or correct the name.", CODE_USAGE);
    }
    // No part of the path may be a link, or root would create folders and
    // mount wherever the link points (audit S1). Parts that do not exist yet
    // are created by mkdir below, under the last existing one.
    $parts = explode('/', substr($point, 1));
    $path = '';
    foreach ($parts as $part) {
        $path .= '/' . $part;
        if (is_link($path)) {
            throw new Fail("Refused: the mount location $point goes through a link ($path).", CODE_REFUSED);
        }
        if (!file_exists($path)) {
            break;
        }
    }
    if (!file_exists($point)) {
        return;
    }
    if (!is_dir($point)) {
        throw new Fail("Refused: the mount location $point exists and is not a folder.", CODE_REFUSED);
    }
    if (in_array($point, mount_points(), true)) {
        throw new Fail("Refused: something is already mounted at $point.", CODE_REFUSED);
    }
    $content = scandir($point);
    if ($content === false || count($content) > 2) {
        throw new Fail("Refused: the mount location $point is not an empty folder. Perhaps a dependent ran while "
            . 'the volume was locked and wrote there. Move or delete what is in it, then mount again.', CODE_REFUSED);
    }
}

/** Lock an unlocked volume again. Returns whether it is locked afterwards. */
function lock_again(string $mapper): bool
{
    $device = MAPPER_DIR . '/' . $mapper;
    if (!file_exists($device) && !is_link($device)) {
        return true;
    }
    $r = run([program('cryptsetup'), 'close', $mapper], TOOL_TIMEOUT);
    return $r['code'] === 0;
}

/**
 * Unlock and mount one volume (docs/DESIGN-engine.md, section 7).
 * Whatever goes wrong, the steps already taken are undone.
 */
function do_mount(string $name, string $file, string $point, bool $read_only,
                  array $keyfiles = [], bool $pim = false, bool $hidden = false,
                  ?string $unlock_id = null): void
{
    $token = $unlock_id ?? bin2hex(random_bytes(16));
    // A very early cancel for this exact unlock may have arrived before we
    // took the lock; any other cancel marker belongs to an earlier unlock (review C3).
    $existing_cancel = read_marker(CANCEL_FILE);
    if ($existing_cancel !== null) {
        @unlink(CANCEL_FILE);
        if (trim($existing_cancel) === $token) {
            throw new Fail('Unlocking was cancelled.', CODE_UNLOCK_FAILED);
        }
    }
    // One message for every refusal, so it does not tell which files exist
    // elsewhere on the server (audit S3, as for keyfiles).
    $real = plain_mnt_path($file) ? realpath($file) : false;
    if ($real === false || !str_starts_with($real, '/mnt/') || !is_file($real)) {
        throw new Fail("The volume file $file cannot be used: it must be an ordinary file under /mnt/.", CODE_USAGE);
    }
    $keyfiles = check_keyfiles($keyfiles, $real);
    $mapper = MAPPER_PREFIX . $name;
    $device = MAPPER_DIR . '/' . $mapper;

    // Safety checks. Nothing has been changed when one of them refuses.
    if (file_exists($device) || is_link($device)) {
        throw new Fail("Refused: \"$name\" is already unlocked or mounted.", CODE_REFUSED);
    }
    $loop = file_in_use($real);
    if ($loop !== null) {
        throw new Fail("Refused: the volume file is already in use on this server (as $loop).", CODE_REFUSED);
    }
    check_mount_point($point);
    // VOL-7: mounting here while Windows has it open would corrupt the volume.
    $client = network_open($real) ?? ($real === $file ? null : network_open($file));
    if ($client !== null) {
        throw new Fail("Refused: the volume file is open over the network ($client).", CODE_REFUSED);
    }
    // Check once more in case a cancel or stop signal arrived during the checks above.
    if ($GLOBALS['vcm_stop'] || cancel_matches($token)) {
        if (cancel_matches($token)) {
            @unlink(CANCEL_FILE);
        }
        throw new Fail('Unlocking was cancelled.', CODE_UNLOCK_FAILED);
    }

    // Unlock. cryptsetup reads the password itself, straight from our
    // standard input, and with a PIM the PIM after it (the next line, or a
    // second prompt on a terminal). This program never sees either. Keyfiles
    // are passed by path; their content is read by cryptsetup alone (SEC-1).
    $command = [program('cryptsetup'), 'tcryptOpen', '--veracrypt'];
    if ($pim) {
        $command[] = '--veracrypt-query-pim';
    }
    foreach ($keyfiles as $keyfile) {
        $command[] = '--key-file';
        $command[] = $keyfile;
    }
    if ($hidden) {
        $command[] = '--tcrypt-hidden';
    }
    if ($read_only) {
        $command[] = '--readonly';
    }
    $command[] = $real;
    $command[] = $mapper;
    write_marker(UNLOCKING_FILE, time() . ' ' . $token);
    try {
        $r = run($command, UNLOCK_TIMEOUT, STDIN, true, true, $token);
    } finally {
        if (cancel_matches($token)) {
            @unlink(CANCEL_FILE);
        }
        @unlink(UNLOCKING_FILE);
    }
    if ($r['code'] !== 0) {
        $locked = lock_again($mapper);
        if ($r['cancelled'] || $r['timed_out']) {
            // cryptsetup may have been ended just after the password was
            // accepted, while it set up the device (review C1). Make sure.
            if (!$locked) {
                sleep(1);
                $locked = lock_again($mapper);
            }
            throw new Fail(($r['cancelled'] ? 'Unlocking was cancelled.' : 'Unlocking took too long and was stopped.')
                . ($locked ? '' : ' The volume could NOT be locked again: dismount it, or restart the server.'),
                CODE_UNLOCK_FAILED);
        }
        if ($r['code'] === 2) {
            // cryptsetup cannot tell which part was wrong.
            $parts = ['password'];
            if ($pim) {
                $parts[] = 'PIM';
            }
            if ($keyfiles !== []) {
                $parts[] = count($keyfiles) > 1 ? 'keyfiles' : 'keyfile';
            }
            $what = count($parts) > 1
                ? implode(', ', array_slice($parts, 0, -1)) . ' or ' . end($parts)
                : 'password';
            throw new Fail("Could not unlock: wrong $what,"
                . ($hidden ? ' no hidden volume inside,' : '') . ' or not a VeraCrypt volume.', CODE_UNLOCK_FAILED);
        }
        if ($r['code'] === 1) {
            // The password was right, but the kernel cannot map the volume: on
            // the test server only TrueCrypt volumes from before 5.0 (cipher cascades in CBC
            // mode, Blowfish) did this (TC-1).
            throw new Fail('cryptsetup could not open the volume (its result code was 1). If it is an old '
                . 'TrueCrypt volume (before version 5.0), Linux cannot open its cipher mode: copy its files '
                . 'into a new VeraCrypt volume on a PC that can still open it.',
                CODE_USAGE);
        }
        throw new Fail("cryptsetup could not open the volume (its result code was {$r['code']}).", CODE_USAGE);
    }

    // If a stop signal arrived right after cryptsetup finished, roll back now
    // rather than leaving an unlocked volume behind (review C5).
    if ($GLOBALS['vcm_stop']) {
        $locked = lock_again($mapper);
        if (!$locked) {
            sleep(1);
            $locked = lock_again($mapper);
        }
        throw new Fail('Unlocking was cancelled.'
            . ($locked ? '' : ' The volume could NOT be locked again: dismount it, or restart the server.'),
            CODE_UNLOCK_FAILED);
    }

    // Which filesystem is inside? -p reads the device itself, never blkid's
    // cache, which could still hold an earlier volume of this name (audit B14).
    $r = run([program('blkid'), '-p', '-o', 'value', '-s', 'TYPE', $device], TOOL_TIMEOUT);
    $found = trim($r['out']);
    // FS-1: every file system both VeraCrypt and Unraid support. ext2 and ext3
    // are mounted with the ext4 driver, which reads them.
    $drivers = ['ntfs' => 'ntfs3', 'exfat' => 'exfat', 'vfat' => 'vfat',
                'ext2' => 'ext4', 'ext3' => 'ext4', 'ext4' => 'ext4', 'xfs' => 'xfs', 'btrfs' => 'btrfs'];
    if (!isset($drivers[$found])) {
        $locked = lock_again($mapper);
        throw new Fail(
            'The volume was unlocked, but its file system is not one this plugin mounts'
            . ($found === '' ? ' (none found)' : " (found: $found)")
            . '. Supported: FAT32, exFAT, NTFS, ext2/3/4, XFS and Btrfs. '
            . ($locked ? 'It was locked again.' : 'It could NOT be locked again.'),
            CODE_FILESYSTEM
        );
    }

    // Unlocking can take minutes. Look again at what may have changed
    // meanwhile: the mount location (audit S1) and a network client opening
    // the volume file (VOL-7, audit S12). And a copy of a mounted XFS volume:
    // XFS refuses a second file system with the same ID (audit B14). Btrfs
    // gives such a copy a temporary ID of its own (kernel 6.7 and later).
    $xfs_uuid = $found === 'xfs' ? filesystem_uuid($device) : '';
    try {
        if ($found === 'xfs') {
            $twin = xfs_twin($name, $xfs_uuid);
            if ($twin !== null) {
                throw new Fail("Refused: its file system has the same ID (UUID) as the mounted volume \"$twin\", "
                    . 'so it is probably a copy of it. XFS cannot mount both at once. Dismount "'
                    . $twin . '" first.', CODE_REFUSED);
            }
        }
        check_mount_point($point);
        $client = network_open($real) ?? ($real === $file ? null : network_open($file));
        if ($client !== null) {
            throw new Fail("Refused: the volume file was opened over the network ($client) while it was being unlocked.", CODE_REFUSED);
        }
        if ($GLOBALS['vcm_stop']) {
            throw new Fail('Unlocking was cancelled.', CODE_UNLOCK_FAILED);
        }
    } catch (Fail $e) {
        $locked = lock_again($mapper);
        if (!$locked) {
            sleep(1);
            $locked = lock_again($mapper);
        }
        throw new Fail($e->getMessage() . ($locked ? ' The volume was locked again.' : ' The volume could NOT be locked again.'), $e->getCode());
    }

    // Mount. Never with the "force" option. Once mounting begins, a deferred
    // stop signal lets the mount, share and dependents finish cleanly (review C5).
    $created = false;
    if (!is_dir($point)) {
        if (!@mkdir($point, 0755, true)) {
            $locked = lock_again($mapper);
            throw new Fail("Could not create the mount location $point. "
                . ($locked ? 'The volume was locked again.' : 'The volume could NOT be locked again.'), CODE_FILESYSTEM);
        }
        $created = true;
    }
    $options = 'nosuid,nodev';
    // FS-4: FAT32, exFAT and NTFS store no owners, so every file appears as
    // nobody:users, Unraid's convention. ext4, XFS and Btrfs keep their own.
    if (in_array($found, ['ntfs', 'exfat', 'vfat'], true)) {
        $options .= ',uid=99,gid=100';
    }
    if ($found === 'ntfs') {
        $options .= ',windows_names';   // FS-3
    }
    if ($found === 'vfat') {
        // Without it the kernel uses iso8859-1, and names with characters
        // outside Western European ones (emoji, Asian scripts) come out wrong.
        $options .= ',utf8';
    }
    if ($read_only) {
        $options .= ',ro';
    }
    $r = run([program('mount'), '-t', $drivers[$found], '-o', $options, $device, $point], TOOL_TIMEOUT);
    if ($r['code'] !== 0) {
        // Read this volume's dm-N before lock_again() removes the mapper device.
        $dm = $found === 'xfs' ? dm_name($device) : null;
        if ($created) {
            @rmdir($point);
        }
        $locked = lock_again($mapper);
        // Duplicate UUID against a non-plugin XFS disk (e.g. an array disk):
        // mount only reports "wrong fs type", while the kernel logs
        // "XFS (dm-N): Filesystem has duplicate UUID ... - can't mount".
        // Check dmesg for this device instead of probing other disks (which
        // would spin up sleeping drives), and never advise xfs_repair
        // (audit 2026-11-27b B6).
        if ($found === 'xfs' && (preg_match('/duplicate|file exists/i', $r['err']) || xfs_duplicate_in_dmesg($dm, $xfs_uuid))) {
            throw new Fail(
                'Refused: its XFS file system has the same ID (UUID) as another mounted XFS file system on this server. '
                . 'XFS cannot mount two file systems with the same ID at once. '
                . ($locked ? 'The volume was locked again.' : 'The volume could NOT be locked again.'),
                CODE_REFUSED
            );
        }
        throw new Fail(
            "The volume was unlocked, but its filesystem could not be mounted.\n"
            . trim($r['err']) . "\n"
            . 'If the volume was not closed cleanly, check its file system first: '
            . ([
                'ntfs' => 'mount it in VeraCrypt on Windows and run a disk check (chkdsk).',
                'exfat' => 'mount it in VeraCrypt on Windows and run a disk check (chkdsk).',
                'vfat' => 'mount it in VeraCrypt on Windows and run a disk check (chkdsk).',
                'xfs' => 'run xfs_repair on the unlocked volume; if it was mounted read-only, mount it once read-write so its journal can be replayed.',
                'btrfs' => 'run btrfs check on the unlocked volume; if it was mounted read-only, mount it once read-write.',
            ][$found] ?? 'run fsck on the unlocked volume; if it was mounted read-only, mount it once read-write so its journal can be replayed.')
            . "\n"
            . ($locked ? 'The volume was locked again.' : 'The volume could NOT be locked again.'),
            CODE_FILESYSTEM
        );
    }
    clear_idle_entry($name);
}

/** The ID (UUID) of the file system on a device, read from the device itself. */
function filesystem_uuid(string $device): string
{
    $r = run([program('blkid'), '-p', '-o', 'value', '-s', 'UUID', $device], TOOL_TIMEOUT);
    return $r['code'] === 0 ? trim($r['out']) : '';
}

/**
 * Did the kernel refuse this XFS mount because its UUID is already mounted
 * elsewhere on the server? Look at the last kernel messages for this volume's
 * own dm-N. Reading dmesg never touches other disks, so sleeping drives stay
 * asleep (audit 2026-11-27b B6).
 */
function xfs_duplicate_in_dmesg(?string $dm, string $uuid): bool
{
    if ($dm === null) {
        return false;
    }
    try {
        $r = run([program('dmesg')], TOOL_TIMEOUT);
    } catch (Fail $e) {
        return false;
    }
    if ($r['code'] !== 0) {
        return false;
    }
    $lines = array_slice(explode("\n", trim($r['out'])), -30);
    $pattern = '/\bXFS \(' . preg_quote($dm, '/') . '\): Filesystem has duplicate UUID\b/i';
    foreach (array_reverse($lines) as $line) {
        if (preg_match($pattern, $line) === 1 && ($uuid === '' || stripos($line, $uuid) !== false)) {
            return true;
        }
    }
    return false;
}

/**
 * Another unlocked volume of this plugin whose XFS file system has the same ID
 * as this device, typically the original of a copied volume file. Returns its
 * name, or null.
 */
function xfs_twin(string $name, string $uuid): ?string
{
    if ($uuid === '') {
        return null;
    }
    foreach (live_volumes() as $other => $live) {
        $other = (string) $other;
        if ($other !== $name && $live['filesystem'] === 'xfs'
            && filesystem_uuid(MAPPER_DIR . '/' . MAPPER_PREFIX . $other) === $uuid) {
            return $other;
        }
    }
    return null;
}

function command_mount(array $args, array $options, bool $json): int
{
    if ($options['unlock_id'] !== null && !preg_match(UNLOCK_TOKEN_PATTERN, $options['unlock_id'])) {
        throw new Fail('That is not a valid unlock identifier.', CODE_USAGE);
    }
    if ($options['pim'] && $options['no_pim']) {
        throw new Fail('Cannot use --pim and --no-pim together.', CODE_USAGE);
    }
    $config = load_config();

    if ($options['file'] !== null || $options['name'] !== null) {
        // Mount without saving: nothing about it is stored or logged.
        if ($args !== [] || $options['file'] === null || $options['name'] === null || $options['no_pim']) {
            throw new Fail('Usage: vcmount mount --file <path> --name <name> [--read-only] [--keyfile <path>]... [--pim] [--hidden]', CODE_USAGE);
        }
        $name = $options['name'];
        if (!preg_match(NAME_PATTERN, $name)) {
            throw new Fail('That is not a valid volume name.', CODE_USAGE);
        }
        if (isset($config[$name])) {
            throw new Fail("A saved volume is already named \"$name\". Choose another name.", CODE_USAGE);
        }
        if (!plain_mnt_path($options['file'])) {
            throw new Fail('That is not a valid path to a volume file.', CODE_USAGE);
        }
        $keyfiles = read_keyfiles($name, $options['keyfile'], $options['file']);
        if ($options['no_password'] && $keyfiles === []) {
            throw new Fail('Enter the password.', CODE_USAGE);
        }
        $saved = false;
        $volume = [
            'file' => $options['file'], 'mount_at' => "/mnt/addons/$name", 'read_only' => false,
            'hidden' => $options['hidden'], 'pim' => $options['pim'],
            'keyfiles' => $keyfiles, 'dependents' => [], 'share' => null,
        ];
    } else {
        // A saved volume uses its saved keyfiles, PIM and hidden settings.
        // The web layer passes --pim / --no-pim and --no-password so the engine
        // enforces the same credential rules as the single authority (audit B17.1).
        if (count($args) !== 1 || $options['keyfile'] !== [] || $options['hidden']) {
            throw new Fail('Usage: vcmount mount <name> [--read-only]', CODE_USAGE);
        }
        $name = $args[0];
        if (!preg_match(NAME_PATTERN, $name)) {
            throw new Fail('That is not a valid volume name.', CODE_USAGE);
        }
        if (!isset($config[$name])) {
            throw new Fail("There is no saved volume named \"$name\".", CODE_USAGE);
        }
        $saved = true;
        $volume = $config[$name];
        if ($options['no_pim'] && $volume['pim']) {
            throw new Fail('This volume asks for a PIM. Enter it.', CODE_USAGE);
        }
        if ($options['pim'] && !$volume['pim']) {
            throw new Fail('This volume does not use a PIM.', CODE_USAGE);
        }
        if ($options['no_password'] && $volume['keyfiles'] === []) {
            throw new Fail('Enter the password.', CODE_USAGE);
        }
    }
    $read_only = $volume['read_only'] || $options['read_only'];

    // The web page adds --over-http when the password came over plain HTTP.
    if ($options['over_http'] && setting('require_https', SETTINGS['require_https'])) {
        throw new Fail('Refused: the setting "require HTTPS" is on. Open the page over HTTPS to unlock.', CODE_REFUSED);
    }

    $lock = take_lock();
    // A save between reading the settings and taking the lock: start again
    // with the new ones (audit 2026-11-27c S8).
    if ($saved && (load_config()[$name] ?? null) !== $volume) {
        throw new Fail("The settings of \"$name\" changed just now. Try again.", CODE_IN_PROGRESS);
    }
    // Catch stop signals across the whole mount so a signal never cuts off the
    // engine between unlocking, mounting, sharing and starting dependents
    // (review C5). During cryptsetup, run() replaces these temporarily to stop
    // cryptsetup at once, then restores them on exit.
    $GLOBALS['vcm_stop'] = false;
    $previous_signals = defer_signals();
    try {
        try {
            do_mount($name, $volume['file'], $volume['mount_at'], $read_only,
                     $volume['keyfiles'], $volume['pim'], $volume['hidden'], $options['unlock_id']);
        } catch (Fail $e) {
            if ($saved) {
                $reasons = [
                    CODE_UNLOCK_FAILED => 'could not unlock',
                    CODE_REFUSED => 'refused by a safety check',
                    CODE_FILESYSTEM => 'filesystem could not be mounted',
                ];
                $reason = $reasons[$e->getCode()] ?? 'error';
                // A cancel (also by the array-stop hooks) and the time limit are no
                // wrong password; say what happened.
                if (str_starts_with($e->getMessage(), 'Unlocking was cancelled')) {
                    $reason = 'cancelled';
                } elseif (str_starts_with($e->getMessage(), 'Unlocking took too long')) {
                    $reason = 'unlocking took too long';
                }
                log_event("mount of \"$name\" failed: $reason");
            }
            throw $e;
        }
        $failed = [];
        $share_error = null;
        if ($saved) {
            log_event("mounted \"$name\"" . ($read_only ? ' read-only' : ''));
            // The share comes before the dependents; a share that fails does not
            // hold them back.
            if ($volume['share'] !== null) {
                try {
                    add_share($name, $volume['share'], $volume['mount_at'], $read_only);
                    log_event("shared \"$name\" over SMB");
                } catch (Fail $e) {
                    $share_error = $e->getMessage();
                    log_event("share of \"$name\" could not be added", true);
                }
            }
            $failed = start_dependents($name, $volume['dependents']);
        }
        $code = $share_error !== null ? CODE_SHARE : ($failed === [] ? CODE_OK : CODE_DEPENDENT);

        if ($json) {
            $v = describe($name, $saved ? $volume : null, live_volumes()[$name] ?? null);
            echo json_encode(
                ['ok' => true, 'code' => $code, 'volume' => $v, 'share_error' => $share_error, 'failed_dependents' => $failed,
                 'top_folder_blocked' => $share_error === null && top_folder_blocked($name, $saved ? $volume : null)],
                JSON_UNESCAPED_SLASHES
            ), "\n";
            return $code;
        }
        echo "Mounted \"$name\" at {$volume['mount_at']}", $read_only ? ' (read-only).' : '.', "\n";
        if ($share_error !== null) {
            fwrite(STDERR, $share_error . "\n");
        } elseif ($saved && $volume['share'] !== null) {
            echo 'Shared as \\\\', php_uname('n'), '\\', $name, ".\n";
        }
        foreach ($failed as $f) {
            fwrite(STDERR, "Dependent \"{$f['container']}\" could not be started: {$f['reason']}\n");
        }
        if ($share_error === null && top_folder_blocked($name, $saved ? $volume : null)) {
            echo "Note: the share cannot write yet, because the volume's top folder belongs to another user.\n",
                 "To let it, run: vcmount fix-top $name   (only the top folder is changed)\n";
        }
        return $code;
    } finally {
        restore_signals($previous_signals);
    }
}

/** How a program is named to the user: its name and process number. */
function program_label(string $proc_dir): string
{
    // A program chooses its own name: keep only plain characters (audit S6).
    $comm = preg_replace('/[^A-Za-z0-9 ._+:@\/-]/', '?', trim((string) @file_get_contents("$proc_dir/comm")));
    return $comm . ' (process ' . basename($proc_dir) . ')';
}

/**
 * Names for a log line, each in double quotes, so that log_event() leaves
 * them out unless "Show volume names in logs" is on (PRIV-1, audit S6).
 */
function quoted_list(array $names): string
{
    return implode(', ', array_map(fn($n) => '"' . $n . '"', $names));
}

/**
 * Which programs on the server hold something open below this folder?
 * Returns, per program, its process number (pid) and its label. Never file
 * names. Programs inside a container are not seen here; see mount_users().
 */
function holders(string $point): array
{
    $found = [];
    $dirs = glob('/proc/[0-9]*', GLOB_ONLYDIR);
    foreach ($dirs === false ? [] : $dirs as $dir) {
        $fds = glob("$dir/fd/*");
        // Also the program file itself (exe): a program started from the
        // volume holds it even with no file open (audit B7).
        $links = array_merge(["$dir/cwd", "$dir/root", "$dir/exe"], $fds === false ? [] : $fds);
        $holds = false;
        foreach ($links as $link) {
            $target = @readlink($link);
            if ($target !== false && below($target, $point)) {
                $holds = true;
                break;
            }
        }
        // And files mapped into memory (databases, libraries), which stay in
        // use after the program closed them (audit B7).
        if (!$holds) {
            $maps = @file("$dir/maps", FILE_IGNORE_NEW_LINES);
            foreach ($maps === false ? [] : $maps as $line) {
                $slash = strpos($line, '/');
                if ($slash !== false && below(substr($line, $slash), $point)) {
                    $holds = true;
                    break;
                }
            }
        }
        if ($holds) {
            $found[] = ['pid' => (int) basename($dir), 'label' => program_label($dir)];
        }
    }
    return $found;
}

/** Is this path the folder itself or something inside it? */
function below(string $path, string $point): bool
{
    return $path === $point || strncmp($path, "$point/", strlen($point) + 1) === 0;
}

/** Docker container ID of a process from its cgroup, or null if not in a container. */
function process_container_id(string $proc_dir): ?string
{
    return preg_match('#docker[-/]([0-9a-f]{64})#', (string) @file_get_contents("$proc_dir/cgroup"), $m)
        ? $m[1] : null;
}

/**
 * Who still has this device mounted? Asked after the volume was dismounted on
 * the server itself: what is left then are containers that were given a
 * folder of the volume, and they keep the volume from being locked.
 *
 * $device_number is the kernel's number of the device, such as "254:3".
 * Returns 'containers' (Docker ID => label) and 'programs' (labels of
 * programs that are not inside a container).
 */
function mount_users(string $device_number): array
{
    $ids = [];
    $programs = [];
    $dirs = glob('/proc/[0-9]*', GLOB_ONLYDIR);
    foreach ($dirs === false ? [] : $dirs as $dir) {
        $lines = @file("$dir/mountinfo", FILE_IGNORE_NEW_LINES);
        $uses = false;
        foreach ($lines === false ? [] : $lines as $line) {
            // The third field of each line is the device number.
            if ((explode(' ', $line, 4)[2] ?? '') === $device_number) {
                $uses = true;
                break;
            }
        }
        if (!$uses) {
            continue;
        }
        // A program inside a container carries the container's ID in its cgroup,
        // after "docker-" or "docker/" (audit S5: not just any long hex string).
        $id = process_container_id($dir);
        if ($id !== null) {
            $ids[$id] = true;
        } else {
            $programs[] = program_label($dir);
        }
    }

    $containers = [];
    foreach (array_keys($ids) as $id) {
        $containers[(string) $id] = container_label((string) $id);
    }
    return ['containers' => $containers, 'programs' => $programs];
}

/** "container <name>" for a Docker container ID, or its short ID if unknown. */
function container_label(string $id): string
{
    $r = run([program('docker'), 'inspect', '--type', 'container', '--format', '{{.Name}}', $id], TOOL_TIMEOUT);
    return 'container ' . ($r['code'] === 0 ? ltrim(trim($r['out']), '/') : substr($id, 0, 12));
}

/**
 * Forced dismount only: stop these containers with "docker stop", never by
 * killing their programs one by one (audit 2026-11-27c S3). $containers maps
 * Docker ID => label. Returns notes; logs for a saved volume.
 */
function force_stop_containers(array $containers, string $name, bool $saved): array
{
    $notes = [];
    $stopped = [];
    $failed = [];
    foreach ($containers as $id => $container) {
        $wait = fitting(FORCE_WAIT, 5);
        $r = run([program('docker'), 'stop', '-t', (string) $wait, (string) $id], $wait + 30);
        // Report only what Docker confirms (audit B12).
        if ($r['code'] === 0) {
            $stopped[] = "\"$container\"";
        } else {
            $failed[] = "\"$container\"";
        }
    }
    if ($stopped !== []) {
        $notes[] = 'Forced: stopped ' . implode(', ', $stopped) . '.';
        if ($saved) {
            log_event("dismount of \"$name\" forced: stopped " . implode(', ', $stopped), true);
        }
    }
    if ($failed !== []) {
        $notes[] = 'Could not stop ' . implode(', ', $failed) . '.';
        if ($saved) {
            log_event("dismount of \"$name\" forced: could not stop " . implode(', ', $failed), true);
        }
    }
    return $notes;
}

/** The process numbers of this program and of everything that started it. */
function own_ancestors(): array
{
    $pids = [];
    $pid = getmypid();
    while ($pid > 1 && !in_array($pid, $pids, true)) {
        $pids[] = $pid;
        $status = (string) @file_get_contents("/proc/$pid/status");
        $pid = preg_match('/^PPid:\s+(\d+)/m', $status, $m) ? (int) $m[1] : 0;
    }
    return $pids;
}

/**
 * When a running process started (field 22 of /proc/<pid>/stat), or null if
 * there is no such process or it has finished (a zombie).
 */
function process_start(string $pid): ?string
{
    $stat = @file_get_contents("/proc/$pid/stat");
    if ($stat === false) {
        return null;
    }
    // The program name in brackets may contain spaces; the fields follow it.
    $fields = explode(' ', substr($stat, strrpos($stat, ')') + 2));
    if (count($fields) < 20 || $fields[0] === 'Z') {
        return null;
    }
    return $fields[19];
}

/**
 * Forced dismount only: end the programs that hold a volume open. Each gets
 * the stop signal and FORCE_WAIT seconds; what is left is killed.
 * $holders comes from holders(). Returns the labels of the programs ended.
 */
function end_programs(array $holders): array
{
    $own = own_ancestors();
    $pids = [];
    $labels = [];
    foreach ($holders as $holder) {
        if (in_array($holder['pid'], $own, true)) {
            throw new Fail(
                'Refused: this command was started from inside the volume. Change to another folder and try again.',
                CODE_REFUSED
            );
        }
        if ($holder['pid'] > 1) {
            $pids[] = (string) $holder['pid'];
            $labels[] = $holder['label'];
        }
    }
    if ($pids === []) {
        return [];
    }

    // A process is still "the same one" only while its start time is unchanged:
    // a number freed and handed to a new program must never be killed, and a
    // finished process waiting to be collected (a zombie) is not waited for
    // (audit S5).
    $started = [];
    foreach ($pids as $pid) {
        $started[$pid] = process_start($pid);
    }
    $alive = function (array $pids) use ($started): array {
        return array_values(array_filter($pids, function (string $pid) use ($started): bool {
            return $started[$pid] !== null && process_start($pid) === $started[$pid];
        }));
    };
    $pids = $alive($pids);
    if ($pids === []) {
        return $labels;
    }
    run(array_merge([program('kill'), '-TERM'], $pids), TOOL_TIMEOUT);
    $wait = fitting(FORCE_WAIT, 5);
    for ($i = 0; $i < $wait * 2 && $alive($pids) !== []; $i++) {
        usleep(500000);
    }
    $left = $alive($pids);
    if ($left !== []) {
        run(array_merge([program('kill'), '-KILL'], $left), TOOL_TIMEOUT);
        for ($i = 0; $i < 10 && $alive($left) !== []; $i++) {
            usleep(200000);
        }
    }
    return $labels;
}

/**
 * Stop the dependents of one volume, then dismount and lock it
 * (docs/DESIGN-engine.md, section 9). The caller holds the lock.
 *
 * $volume is the saved volume, or null for one that is not saved.
 * $live is the volume's entry from live_volumes().
 * $force: if the volume is still in use, end what holds it open and try
 * again. Without it a busy volume stays mounted. Never "lazy" either way.
 * Returns notes on what else happened, for example a dependent that was killed.
 */
function do_dismount(string $name, ?array $volume, ?array $live, bool $force): array
{
    $saved = $volume !== null;
    $mapper = MAPPER_PREFIX . $name;
    $dm = dm_name(MAPPER_DIR . '/' . $mapper);
    $device_number = $dm === null ? '' : trim((string) @file_get_contents("/sys/block/$dm/dev"));

    // First the share, so network clients let go of the volume (section 9b).
    // Only then is waiting for Samba's workers worth it below (audit
    // 2026-11-27c S1): at array stop Samba has already stopped.
    $share_closed = (is_file(share_file($name)) || hook_has($name)) && samba_running();
    $notes = remove_share($name);
    if ($notes !== [] && $saved) {
        log_event("share of \"$name\" could not be removed cleanly", true);
    }

    // Then the dependents, in reverse order (DOC-4, DOC-5).
    $notes = array_merge($notes, array_column(stop_dependents($name, $volume['dependents'] ?? []), 'message'));

    // Dismount. A volume can be mounted in more than one place; take them all.
    for ($round = 0; $round < 5 && $live !== null && $live['mounted_at'] !== null; $round++) {
        $point = $live['mounted_at'];
        $r = run([program('umount'), $point], TOOL_TIMEOUT);
        // Closing the share only asks Samba to let go; its workers may need a
        // moment. Try again for up to two seconds before calling it busy
        // (audit B7), but only if a share was closed.
        for ($try = 0; $share_closed && $r['code'] !== 0 && $try < 4; $try++) {
            usleep(500000);
            $r = run([program('umount'), $point], TOOL_TIMEOUT);
        }
        if ($r['code'] !== 0 && $force) {
            // Programs inside a container (a container given the same path, or
            // all of /mnt/user) are not killed one by one: their container is
            // stopped, so a restart policy cannot bring them straight back
            // (audit 2026-11-27c S3).
            $outside = [];
            $containers = [];
            foreach (holders($point) as $holder) {
                $id = process_container_id('/proc/' . $holder['pid']);
                if ($id === null) {
                    $outside[] = $holder;
                } elseif (!isset($containers[$id])) {
                    $containers[$id] = container_label($id);
                }
            }
            $ended = end_programs($outside);
            if ($ended !== []) {
                $notes[] = 'Forced: ended ' . implode(', ', $ended) . '.';
                if ($saved) {
                    log_event("dismount of \"$name\" forced: ended " . quoted_list($ended), true);
                }
            }
            if ($containers !== []) {
                $notes = array_merge($notes, force_stop_containers($containers, $name, $saved));
            }
            if ($ended !== [] || $containers !== []) {
                $r = run([program('umount'), $point], TOOL_TIMEOUT);
            }
        }
        if ($r['code'] !== 0) {
            $fail = new Fail(
                "Dismount aborted: \"$name\" is still in use. It stays mounted"
                . ($force ? ", although force was used.\n" : "; nothing was forced.\n") . trim($r['err']),
                CODE_BUSY
            );
            $programs = array_column(holders($point), 'label');
            $fail->details = ['programs' => $programs];
            if ($saved) {
                // Program names and process numbers only, never file names.
                log_event(
                    "dismount of \"$name\" aborted: still in use"
                    . ($programs === [] ? '' : ' by ' . quoted_list($programs)),
                    true
                );
            }
            throw $fail;
        }
        // Remove the empty folder, but only where this plugin creates them.
        if (strncmp($point, '/mnt/addons/', 12) === 0) {
            @rmdir($point);
        }
        $live = live_volumes()[$name] ?? null;
    }

    // Lock. A container that was given a folder of the volume still has it
    // mounted and keeps it from being locked.
    $locked = lock_again($mapper);
    $users = ['containers' => [], 'programs' => []];
    if (!$locked && $device_number !== '') {
        $users = mount_users($device_number);
        if ($force && $users['containers'] !== []) {
            $notes = array_merge($notes, force_stop_containers($users['containers'], $name, $saved));
            $locked = lock_again($mapper);
            if (!$locked) {
                $users = mount_users($device_number);
            }
        }
    }
    if (!$locked) {
        if ($saved) {
            log_event("\"$name\" was dismounted but could not be locked", true);
        }
        $fail = new Fail("\"$name\" was dismounted, but it could not be locked. Try again.", CODE_BUSY);
        $fail->details = ['programs' => array_merge(array_values($users['containers']), $users['programs'])];
        throw $fail;
    }
    if ($saved) {
        log_event("dismounted \"$name\"");
    }
    clear_idle_entry($name);
    return $notes;
}

/**
 * Dismount and lock every volume that is unlocked or mounted, one after the
 * other. Used by the array-stop hook. A volume that is still in use stays
 * mounted and the others are still dismounted; the result is then code 5.
 */
function dismount_all(bool $json, bool $force): int
{
    // A fault in the configuration must not keep volumes mounted. Without the
    // configuration every volume counts as "not saved", so nothing is logged.
    $lock = take_lock();
    try {
        $config = load_config();
    } catch (Fail $e) {
        $config = [];
    }
    $results = [];
    $failed = false;
    foreach (live_volumes() as $name => $live) {
        $name = (string) $name;
        if (out_of_time(5)) {
            // Not started: half a dismount would be worse than none.
            $failed = true;
            $results[] = ['name' => $name, 'ok' => false, 'code' => CODE_BUSY,
                          'error' => "\"$name\" was left mounted: no time was left.", 'details' => null];
            // Only for a saved volume: a "Mount a file once" volume leaves no
            // trace in the log (PRIV-2, audit 2026-11-27c S4).
            if (isset($config[$name])) {
                log_event("dismount of \"$name\" was not started: no time was left", true);
            }
            continue;
        }
        try {
            $notes = do_dismount($name, $config[$name] ?? null, $live, $force);
            $results[] = [
                'name' => $name,
                'ok' => true,
                'message' => "Dismounted and locked \"$name\".",
                'notes' => $notes,
            ];
        } catch (Fail $e) {
            $failed = true;
            $results[] = [
                'name' => $name,
                'ok' => false,
                'code' => $e->getCode(),
                'error' => $e->getMessage(),
                'details' => $e->details,
            ];
        }
    }
    $code = $failed ? CODE_BUSY : CODE_OK;

    if ($json) {
        echo json_encode(['ok' => !$failed, 'code' => $code, 'results' => $results], JSON_UNESCAPED_SLASHES), "\n";
        return $code;
    }
    if ($results === []) {
        echo "No volume is mounted.\n";
    }
    foreach ($results as $result) {
        if ($result['ok']) {
            foreach ($result['notes'] as $note) {
                echo $note, "\n";
            }
            echo $result['message'], "\n";
            continue;
        }
        fwrite(STDERR, $result['error'] . "\n");
        foreach ($result['details']['programs'] ?? [] as $program) {
            fwrite(STDERR, "  held open by: $program\n");
        }
    }
    return $code;
}

function command_dismount(array $args, array $options, bool $json): int
{
    if ($options['all']) {
        if ($args !== []) {
            throw new Fail('Usage: vcmount dismount --all [--force]', CODE_USAGE);
        }
        // --array-stop is given by the unmounting_disks hook. Force is then on
        // unless the setting "force_at_array_stop" turns it off (LIFE-10).
        $force = $options['force'] || ($options['array_stop'] && setting('force_at_array_stop', SETTINGS['force_at_array_stop']));
        watch_time($options);
        return dismount_all($json, $force);
    }
    if (count($args) !== 1) {
        throw new Fail('Usage: vcmount dismount <name> [--force]', CODE_USAGE);
    }
    $name = $args[0];
    if (!preg_match(NAME_PATTERN, $name)) {
        throw new Fail('That is not a valid volume name.', CODE_USAGE);
    }
    // The settings are read under the lock, so a save cannot slip in between
    // (audit 2026-11-27c S8).
    $lock = take_lock();
    $volume = load_config()[$name] ?? null;
    $saved = $volume !== null;
    $live = live_volumes()[$name] ?? null;
    if ($live === null) {
        if (!$saved) {
            throw new Fail("There is no volume named \"$name\".", CODE_USAGE);
        }
        report($json, $name, "\"$name\" is already locked.");
        return CODE_OK;
    }
    $notes = do_dismount($name, $volume, $live, $options['force']);
    report($json, $name, "Dismounted and locked \"$name\".", $notes);
    return CODE_OK;
}

/**
 * Stop the dependents of every saved volume that is unlocked or mounted. The
 * volumes stay mounted. Used by the stopping_docker hook, so that dependents
 * get their own grace period before Unraid stops all containers.
 */
function command_stop_dependents(array $args, array $options, bool $json): int
{
    if (!$options['all'] || $args !== []) {
        throw new Fail('Usage: vcmount stop-dependents --all [--within <seconds>]', CODE_USAGE);
    }
    watch_time($options);
    $lock = take_lock();
    // A fault in the configuration must not stop this either (audit B15).
    try {
        $config = load_config();
    } catch (Fail $e) {
        $config = [];
    }
    $live = live_volumes();
    $results = [];
    foreach ($config as $name => $volume) {
        if (isset($live[$name])) {
            $results = array_merge($results, stop_dependents((string) $name, $volume['dependents']));
        }
    }
    $failed = in_array('failed', array_column($results, 'result'), true);
    $code = $failed ? CODE_BUSY : CODE_OK;

    if ($json) {
        echo json_encode(['ok' => !$failed, 'code' => $code, 'results' => $results], JSON_UNESCAPED_SLASHES), "\n";
        return $code;
    }
    if ($results === []) {
        echo "No dependent was running.\n";
    }
    foreach ($results as $result) {
        echo $result['message'], "\n";
    }
    return $code;
}

/**
 * Start the dependents of every saved volume that is mounted, in list order
 * with their delays (DOC-3). Used by the docker_started hook (LIFE-4): after
 * Docker was switched off and on, Unraid starts only its autostart containers,
 * and dependents have autostart off (DOC-7). At array start no volume is
 * mounted yet, so this does nothing there.
 */
function command_start_dependents(array $args, array $options, bool $json): int
{
    if (!$options['all'] || $args !== []) {
        throw new Fail('Usage: vcmount start-dependents --all', CODE_USAGE);
    }
    $lock = take_lock();
    $config = load_config();
    $live = live_volumes();
    $failed = [];
    $started = 0;
    foreach ($config as $name => $volume) {
        $name = (string) $name;
        if (($live[$name]['mounted_at'] ?? null) === null || $volume['dependents'] === []) {
            continue;
        }
        $failed = array_merge($failed, start_dependents($name, $volume['dependents']));
        $started += count($volume['dependents']);
    }
    $code = $failed === [] ? CODE_OK : CODE_DEPENDENT;

    if ($json) {
        echo json_encode(['ok' => $failed === [], 'code' => $code, 'failed_dependents' => $failed], JSON_UNESCAPED_SLASHES), "\n";
        return $code;
    }
    echo $started === 0 ? "No mounted volume has dependents.\n" : "Dependents of the mounted volumes are running.\n";
    foreach ($failed as $f) {
        fwrite(STDERR, "Dependent \"{$f['container']}\" could not be started: {$f['reason']}\n");
    }
    return $code;
}

/**
 * Make the SMB shares match the mounted volumes (section 9b): add the share of
 * every mounted saved volume that should have one, and remove every share of
 * ours that no mounted volume needs. Also puts back include lines that another
 * plugin lost.
 */
function command_repair_shares(array $args, bool $json): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount repair-shares', CODE_USAGE);
    }
    $lock = take_lock();
    $config = load_config();
    $live = live_volumes();
    $notes = [];
    $failed = false;

    $wanted = [];
    foreach ($config as $name => $volume) {
        $name = (string) $name;
        $point = $live[$name]['mounted_at'] ?? null;
        if ($volume['share'] === null || $point === null) {
            continue;
        }
        $wanted[$name] = true;
        $read_only = (bool) $live[$name]['read_only'];
        $text = share_text($name, $volume['share'], $point, $read_only);
        if (share_active($name) && @file_get_contents(share_file($name)) === $text) {
            continue;
        }
        try {
            add_share($name, $volume['share'], $point, $read_only);
            $notes[] = "Added the share of \"$name\".";
            log_event("share of \"$name\" repaired");
        } catch (Fail $e) {
            $failed = true;
            $notes[] = $e->getMessage();
        }
    }

    // Our own leftovers: share files, and include lines that name our folder.
    $names = [];
    foreach (glob(SHARE_DIR . '/*.conf') ?: [] as $file) {
        $names[] = basename($file, '.conf');
    }
    $prefix = 'include = ' . SHARE_DIR . '/';
    foreach (hook_lines() as $line) {
        $line = trim($line);
        if (strncmp($line, $prefix, strlen($prefix)) === 0 && substr($line, -5) === '.conf') {
            $names[] = substr($line, strlen($prefix), -5);
        }
    }
    foreach (array_unique($names) as $name) {
        if (isset($wanted[$name]) || !preg_match(NAME_PATTERN, $name)) {
            continue;
        }
        $problems = remove_share($name);
        $notes[] = "Removed the left-over share \"$name\".";
        if ($problems !== []) {
            $failed = true;
            $notes = array_merge($notes, $problems);
        }
    }
    $code = $failed ? CODE_SHARE : CODE_OK;

    if ($json) {
        echo json_encode(['ok' => !$failed, 'code' => $code, 'notes' => $notes], JSON_UNESCAPED_SLASHES), "\n";
        return $code;
    }
    echo $notes === [] ? "The shares were already in order.\n" : implode("\n", $notes) . "\n";
    return $code;
}

/**
 * The choices the web forms offer: the Unraid users (for a share) and the
 * Docker containers (for dependents). Changes nothing.
 */
/** Unraid's shutdown time-out in seconds (Settings › Disk Settings), 90 if unknown. */
function shutdown_timeout(): int
{
    $ini = @parse_ini_file('/var/local/emhttp/var.ini');
    $value = is_array($ini) ? (string) ($ini['shutdownTimeout'] ?? '') : '';
    return preg_match('/\A[0-9]{1,5}\z/', $value) ? (int) $value : 90;
}

function command_options(array $args, bool $json): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount options', CODE_USAGE);
    }
    // Unraid's own users have user numbers from 1000 up.
    $users = [];
    foreach (@file('/etc/passwd', FILE_IGNORE_NEW_LINES) ?: [] as $line) {
        $fields = explode(':', $line);
        $uid = (int) ($fields[2] ?? -1);
        if ($uid >= 1000 && $uid < 60000 && preg_match(USER_PATTERN, $fields[0])) {
            $users[] = $fields[0];
        }
    }
    sort($users);

    $containers = [];
    $alone = [];
    $notes = [];
    if (docker_ready()) {
        $r = run([program('docker'), 'ps', '-a', '--format', '{{.Names}}'], TOOL_TIMEOUT);
        foreach (preg_split('/\n/', trim($r['out'])) as $line) {
            if (preg_match(CONTAINER_PATTERN, $line)) {
                $containers[] = $line;
            }
        }
        sort($containers);
        $alone = starts_alone($containers);
    } else {
        $notes[] = 'The Docker service is not running, so no containers can be listed.';
    }

    if ($json) {
        echo json_encode(['ok' => true, 'users' => $users, 'containers' => $containers,
                          'starts_alone' => (object) $alone, 'notes' => $notes,
                          'shutdown_timeout' => shutdown_timeout()],
            JSON_UNESCAPED_SLASHES), "\n";
        return CODE_OK;
    }
    echo 'Users:      ', $users === [] ? '-' : implode(', ', $users), "\n";
    echo 'Containers: ', $containers === [] ? '-' : implode(', ', $containers), "\n";
    // Usually many: names only here, the reasons are in --json and on the page.
    echo 'Start alone: ', $alone === [] ? '-' : implode(', ', array_keys($alone)), "\n";
    foreach ($notes as $note) {
        echo $note, "\n";
    }
    return CODE_OK;
}

/** File Activity (PRIV-3): where it is installed and where it keeps its settings. */
const FILE_ACTIVITY_DIR = '/usr/local/emhttp/plugins/file.activity';
const FILE_ACTIVITY_CONFIG = '/boot/config/plugins/file.activity/config.json';

/**
 * The pattern for one folder, without the leading "^/" and the closing
 * "(/|$)", so several can be joined into one line. Inside a user share Unraid
 * has two spellings for the same file, /mnt/user/<share>/... and
 * /mnt/disk3/<share>/..., so the second part of such a path matches any name.
 * Only the characters that mean something in a pattern are escaped, so a part
 * reads like the path (throwaway-ntfs, not throwaway\-ntfs).
 */
function exclusion_part(string $dir): string
{
    $parts = array_values(array_filter(explode('/', $dir), 'strlen'));
    $special = str_split('\\.+*?()|[]{}^$');
    $quoted = array_map(fn($p) => implode('', array_map(
        fn($c) => in_array($c, $special, true) ? '\\' . $c : $c, str_split($p))), $parts);
    if (count($parts) >= 3 && $parts[0] === 'mnt' && in_array($parts[1], ['user', 'user0'], true)) {
        $quoted[1] = '[^/]+';
    }
    return implode('/', $quoted);
}

/**
 * One File Activity exclusion line for all the folders: File Activity takes
 * one pattern per entry, so one line is easiest to add. The alternatives are
 * joined with "|", and a shared "mnt/" is put in front of the brackets:
 * ^/mnt/(addons|[^/]+/data/veracrypt)(/|$). File Activity finds a pattern
 * anywhere in a path (its own defaults, such as "(?i)appdata", have no
 * anchors), so the line starts with ^ and ends at a folder boundary.
 */
function exclusion_line(array $parts): string
{
    $parts = array_values(array_unique($parts));
    $all_mnt = array_filter($parts, fn($p) => strncmp($p, 'mnt/', 4) === 0) === $parts;
    $prefix = $all_mnt ? 'mnt/' : '';
    $inner = array_map(fn($p) => $all_mnt ? substr($p, 4) : $p, $parts);
    $body = count($inner) === 1 ? $inner[0] : '(' . implode('|', $inner) . ')';
    return '^/' . $prefix . $body . '(/|$)';
}

/**
 * Does one of File Activity's patterns already cover a path? File Activity
 * uses RE2, which PHP does not have; for the patterns that matter here (plain
 * text, ^, (?i), [^/]+ and the like) PCRE behaves the same. A pattern PCRE
 * cannot read counts as not covering, so the worst case is a line too many.
 */
function excluded_by(array $patterns, string $path): bool
{
    foreach ($patterns as $pattern) {
        if (is_string($pattern) && $pattern !== '' && @preg_match('~' . str_replace('~', '\~', $pattern) . '~', $path) === 1) {
            return true;
        }
    }
    return false;
}

/**
 * Check for activity-logging plugins (PRIV-3). For every saved volume, its
 * mount point (most important: otherwise the volume's content is logged) and
 * the folder holding its volume file should be excluded in File Activity.
 * Reads File Activity's settings; never changes them.
 */
function command_privacy(array $args, bool $json): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount privacy', CODE_USAGE);
    }
    $installed = is_dir(FILE_ACTIVITY_DIR);
    $readable = false;
    $patterns = [];
    if ($installed && is_file(FILE_ACTIVITY_CONFIG)) {
        $data = json_decode((string) @file_get_contents(FILE_ACTIVITY_CONFIG), true);
        if (is_array($data) && is_array($data['exclusions'] ?? null)) {
            $readable = true;
            $patterns = $data['exclusions'];
        }
    }

    // The folders to exclude. Every mount point under /mnt/addons is covered by
    // excluding all of /mnt/addons: it holds only mounts made by plugins, and it
    // also covers volumes added later. Each folder comes with sample paths that
    // show whether File Activity already leaves it out: one inside the folder,
    // and for a user share also its per-disk spelling.
    $folders = [];
    foreach (load_config() as $volume) {
        $mount = strncmp($volume['mount_at'], '/mnt/addons/', 12) === 0 ? '/mnt/addons' : $volume['mount_at'];
        // Keyfile folders too: File Activity would note every read of a
        // keyfile, with its path and the time of each unlock (audit S10).
        $dirs = array_merge([$mount, dirname($volume['file'])], array_map('dirname', $volume['keyfiles']));
        foreach ($dirs as $dir) {
            $folders[rtrim($dir, '/')] = true;
        }
    }
    $parts = [];
    $missing = [];
    foreach (array_keys($folders) as $dir) {
        $parts[] = exclusion_part($dir);
        $samples = [$dir . '/file'];
        if (preg_match('#^/mnt/user0?/(.+)$#', $dir, $m)) {
            // Its spelling on an array disk and on a pool (audit S10).
            $samples[] = '/mnt/disk1/' . $m[1] . '/file';
            $samples[] = '/mnt/cache/' . $m[1] . '/file';
        }
        $covered = $readable;
        foreach ($samples as $sample) {
            $covered = $covered && excluded_by($patterns, $sample);
        }
        if (!$covered) {
            $missing[] = $dir;
        }
    }
    $line = $parts === [] ? '' : exclusion_line($parts);

    if ($json) {
        echo json_encode(['ok' => true, 'file_activity' => [
            'installed' => $installed,
            'settings_read' => $readable,
            'line' => $line,
            'missing' => $missing,
        ]], JSON_UNESCAPED_SLASHES), "\n";
        return CODE_OK;
    }
    if (!$installed) {
        echo "File Activity is not installed.\n";
        return CODE_OK;
    }
    if (!$readable) {
        echo "File Activity is installed, but its settings could not be read.\n";
    }
    if ($missing === []) {
        echo "File Activity already leaves out every mount point and volume folder.\n";
        return CODE_OK;
    }
    echo "File Activity is installed and can record file names from these folders:\n";
    foreach ($missing as $dir) {
        echo '  ', $dir, "\n";
    }
    echo "Add this line as one entry to its Exclusions (Tools > File Activity, tab Settings).\n",
         "It covers every volume, so it can replace earlier entries made for them:\n",
         '  ', $line, "\n";
    return CODE_OK;
}

/** Is RUN_DIR an existing real folder (not a link) owned by root? */
function run_dir_safe(): bool
{
    clearstatcache(true, RUN_DIR);
    $st = @lstat(RUN_DIR);
    // 0170000 is the file-type mask; 0040000 is a real directory (not a link).
    return $st !== false && ($st['mode'] & 0170000) === 0040000 && $st['uid'] === 0;
}

/**
 * Make sure the runtime folder (/var/run/vcmount) exists with mode 0700, is a
 * real folder (not a link) and belongs to root (audit S12).
 */
function ensure_run_dir(): void
{
    clearstatcache(true, RUN_DIR);
    $st = @lstat(RUN_DIR);
    if ($st === false) {
        if (!@mkdir(RUN_DIR, 0700)) {
            // Another vcmount may have created it at the same instant.
            clearstatcache(true, RUN_DIR);
            $st = @lstat(RUN_DIR);
            if ($st === false) {
                throw new Fail('Could not create ' . RUN_DIR . '.', CODE_USAGE);
            }
        } else {
            @chmod(RUN_DIR, 0700);
            clearstatcache(true, RUN_DIR);
            $st = @lstat(RUN_DIR);
        }
    }
    if ($st === false || ($st['mode'] & 0170000) !== 0040000 || $st['uid'] !== 0) {
        throw new Fail('Refused: ' . RUN_DIR . ' is not a root-owned folder.', CODE_REFUSED);
    }
    if (($st['mode'] & 07777) !== 0700 && !@chmod(RUN_DIR, 0700)) {
        throw new Fail('Could not set permissions on ' . RUN_DIR . '.', CODE_USAGE);
    }
}

/**
 * Write one of the marker files in RUN_DIR atomically with mode 0600. A fresh
 * temp file ('x' fails if anything exists there) is restricted to root, written,
 * and renamed into place — rename replaces any symlink at $path without
 * following it, and concurrent readers never see a half-written file (review C4,
 * audit S12, audit 2026-11-27b S4).
 */
function write_marker(string $path, string $content): bool
{
    ensure_run_dir();
    $temp = $path . '.new.' . getmypid();
    @unlink($temp);
    $handle = @fopen($temp, 'x');
    if ($handle === false) {
        return false;
    }
    @chmod($temp, 0600);
    $ok = fwrite($handle, $content) === strlen($content);
    fclose($handle);
    if (!$ok || !@rename($temp, $path)) {
        @unlink($temp);
        return false;
    }
    return true;
}

/** Read a marker file inside RUN_DIR, never through a link. */
function read_marker(string $path): ?string
{
    if (!run_dir_safe() || is_link($path) || !is_file($path)) {
        return null;
    }
    $text = @file_get_contents($path);
    return $text === false ? null : $text;
}

/**
 * Read UNLOCKING_FILE: returns ['since' => int, 'token' => ?string] or null.
 * Only holds a start timestamp and an opaque hex token (review C3).
 */
function read_unlocking_marker(): ?array
{
    $text = read_marker(UNLOCKING_FILE);
    if ($text === null || !preg_match('/\A([0-9]+)(?:\s+([0-9a-f]{16,64}))?\z/', trim($text), $m)) {
        return null;
    }
    return ['since' => (int) $m[1], 'token' => $m[2] ?? null];
}

/** Does CANCEL_FILE carry the token of this unlock (review C3)? */
function cancel_matches(string $token): bool
{
    $text = read_marker(CANCEL_FILE);
    return $text !== null && trim($text) === $token;
}

/** The idle state as the last idle check wrote it: name => dm, io, since, warned. */
function idle_state(): array
{
    $data = json_decode((string) read_marker(IDLE_FILE), true);
    $state = [];
    foreach (is_array($data) ? $data : [] as $name => $entry) {
        // Cast to string: PHP turns all-digit JSON keys like "2026" into int (audit B1).
        $name = (string) $name;
        if (preg_match(NAME_PATTERN, $name) && is_array($entry)
            && is_string($entry['dm'] ?? null) && is_string($entry['io'] ?? null)
            && is_int($entry['since'] ?? null)) {
            $state[$name] = ['dm' => $entry['dm'], 'io' => $entry['io'], 'since' => $entry['since'],
                             'warned' => !empty($entry['warned'])];
        }
    }
    return $state;
}

/** Drop one volume from IDLE_FILE so a remount starts with a clean slate (audit B5). */
function clear_idle_entry(string $name): void
{
    $state = idle_state();
    if (!isset($state[$name])) {
        return;
    }
    unset($state[$name]);
    if ($state === []) {
        @unlink(IDLE_FILE);
    } else {
        write_marker(IDLE_FILE, json_encode($state));
    }
}

/** For the list: minutes left until a mounted volume is locked when idle. */
function idle_view(string $name, ?int $minutes, ?string $dm = null): array
{
    $entry = $minutes === null ? null : (idle_state()[$name] ?? null);
    if ($entry === null || ($dm !== null && $entry['dm'] !== $dm)) {
        return ['locks_in' => null, 'idle_blocked' => false];
    }
    $idle = intdiv(max(0, time() - $entry['since']), 60);
    return ['locks_in' => max(0, $minutes - $idle), 'idle_blocked' => $entry['warned']];
}

/**
 * The kernel's count of completed reads and writes of a device
 * (/sys/block/dm-N/stat, fields 1 and 5), or null if it cannot be read.
 */
function io_count(string $dm): ?string
{
    $fields = preg_split('/\s+/', trim((string) @file_get_contents("/sys/block/$dm/stat")));
    if (count($fields) < 5 || !preg_match('/\A[0-9]+\z/', $fields[0] . $fields[4])) {
        return null;
    }
    return $fields[0] . ' ' . $fields[4];
}

/** Does this process have a regular file open below the folder? */
function open_file_below(int $pid, string $point): bool
{
    $fds = glob("/proc/$pid/fd/*");
    foreach ($fds === false ? [] : $fds as $fd) {
        $target = @readlink($fd);
        // Check the descriptor ($fd) itself so unlinked (" (deleted)") open
        // files still count and symlinks inside the volume are not followed (audit B2).
        if ($target !== false && below($target, $point) && @is_file($fd)) {
            return true;
        }
    }
    return false;
}

/**
 * What keeps an idle volume from being locked without force: programs that
 * hold it open, and containers using it that are not its dependents (those are
 * stopped). Samba keeps every connected client inside the share's folder, so a
 * Samba process on this plugin's own share counts only with a file open; a
 * connected drive with no open file does not keep the volume.
 */
function idle_blockers(array $volume, string $point, string $dm): array
{
    $blockers = [];
    // Only skip directory-only Samba handles when remove_share() can actually
    // close that share (not for MNT-2 volumes accessed via a parent user share).
    $own_share = $volume['share'] !== null && strncmp($point, '/mnt/user/', 10) !== 0;
    foreach (holders($point) as $holder) {
        // Processes inside a container (even with a 1:1 host bind mount) are
        // checked via mount_users() below so dependents are excluded (audit B2).
        if (process_container_id('/proc/' . $holder['pid']) !== null) {
            continue;
        }
        $comm = trim((string) @file_get_contents('/proc/' . $holder['pid'] . '/comm'));
        if ($own_share && strncmp($comm, 'smbd', 4) === 0 && !open_file_below($holder['pid'], $point)) {
            continue;
        }
        $blockers[] = $holder['label'];
    }
    $device_number = trim((string) @file_get_contents("/sys/block/$dm/dev"));
    if ($device_number !== '') {
        $dependents = array_column($volume['dependents'], 'container');
        foreach (mount_users($device_number)['containers'] as $label) {
            if (!in_array(substr($label, strlen('container ')), $dependents, true)) {
                $blockers[] = $label;
            }
        }
    }
    return $blockers;
}

/** Is Unraid's array started? Volumes are only locked when idle while it is. */
function array_started(): bool
{
    $ini = @parse_ini_file('/var/local/emhttp/var.ini');
    return is_array($ini) && ($ini['mdState'] ?? '') === 'STARTED';
}

/**
 * Idle lock (LIFE-8), run every minute by cron. For each mounted saved volume
 * with an idle lock time: if its read and write counters have not changed for
 * that long, dismount and lock it as a normal dismount does (dependents first),
 * never forced. A volume still in use stays mounted, with one notification
 * until it is used again. Does nothing while another action runs.
 */
function command_idle_check(array $args, bool $json, array $extra = []): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount idle-check', CODE_USAGE);
    }
    $watched = array_filter(load_config(), fn($v) => $v['idle_lock'] !== null);
    if ($watched === [] || !array_started()) {
        if ($watched === [] && read_marker(IDLE_FILE) !== null) {
            @unlink(IDLE_FILE);
        }
        if ($json) {
            echo json_encode(['ok' => true, 'locked' => []] + $extra), "\n";
        }
        return CODE_OK;
    }
    try {
        $lock = take_lock();
    } catch (Fail $e) {
        if ($e->getCode() !== CODE_IN_PROGRESS) {
            throw $e;
        }
        if ($json) {
            echo json_encode(['ok' => true, 'locked' => [], 'busy' => true] + $extra), "\n";
        }
        return CODE_OK;   // another action runs; look again in a minute
    }
    // Read again under the lock (audit 2026-11-27c S8).
    $watched = array_filter(load_config(), fn($v) => $v['idle_lock'] !== null);

    $live = live_volumes();
    $old = idle_state();
    $state = [];
    $locked = [];
    foreach ($watched as $name => $volume) {
        $name = (string) $name;
        $now = time();   // fresh per volume, so a slow dismount does not shorten the next (audit B5)
        $vol = $live[$name] ?? null;
        $dm = dm_name(MAPPER_DIR . '/' . MAPPER_PREFIX . $name);
        $io = $dm === null ? null : io_count($dm);
        if ($vol === null || $vol['mounted_at'] === null || $io === null) {
            continue;
        }
        $entry = $old[$name] ?? null;
        if ($entry === null || $entry['dm'] !== $dm || $entry['io'] !== $io) {
            // Newly mounted, or used since the last look: the time starts again.
            $state[$name] = ['dm' => $dm, 'io' => $io, 'since' => $now, 'warned' => false];
            continue;
        }
        $state[$name] = $entry;
        if ($now - $entry['since'] < $volume['idle_lock'] * 60) {
            continue;
        }
        // The array or Docker is being stopped: the hooks dismount, not this.
        if (stop_requested() || !array_started()) {
            continue;
        }
        $blockers = idle_blockers($volume, $vol['mounted_at'], $dm);
        if ($blockers !== []) {
            if (!$entry['warned']) {
                log_event("\"$name\" was idle for {$volume['idle_lock']} minutes but is not locked: still in use by "
                    . quoted_list($blockers), true);
                $state[$name]['warned'] = true;
            }
            continue;
        }
        try {
            do_dismount($name, $volume, $vol, false);
            unset($state[$name]);
            $locked[] = $name;
            log_event("\"$name\" was locked after {$volume['idle_lock']} minutes without reads or writes", true, 'normal');
        } catch (Fail $e) {
            // do_dismount has logged and reported it. Wait a full idle time
            // before the next try, so a failure is not repeated every minute.
            $state[$name] = ['dm' => $dm, 'io' => $io, 'since' => time(), 'warned' => true];
        }
    }
    if ($state === []) {
        @unlink(IDLE_FILE);
    } else {
        write_marker(IDLE_FILE, json_encode($state));
    }
    if ($json) {
        echo json_encode(['ok' => true, 'locked' => $locked] + $extra), "\n";
    }
    return CODE_OK;
}

/**
 * The minute check as cron runs it: first dependents running while their
 * volume is locked (DOC-6), then the idle lock (LIFE-8). Its output goes
 * nowhere, so a failure would go unnoticed. Report the first failure in the
 * log and as an alert, stay quiet while it keeps failing, and say when it
 * works again.
 */
function minute_check_reported(array $args, bool $json): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount check', CODE_USAGE);
    }
    try {
        try {
            $stopped = stray_dependents();
        } catch (Fail $e) {
            if ($e->getCode() !== CODE_IN_PROGRESS) {
                throw $e;
            }
            $stopped = [];   // another action runs; look again in a minute
        }
        $code = command_idle_check([], $json, ['stopped' => $stopped]);
    } catch (Throwable $e) {
        if (read_marker(IDLE_ERROR_FILE) === null) {
            write_marker(IDLE_ERROR_FILE, (string) time());
            log_event('the minute check failed, so idle volumes are not locked and dependents of locked volumes '
                . 'are not stopped: ' . $e->getMessage(), true, 'alert');
        }
        throw $e instanceof Fail ? $e : new Fail('The minute check failed: ' . $e->getMessage(), CODE_USAGE);
    }
    if (read_marker(IDLE_ERROR_FILE) !== null) {
        @unlink(IDLE_ERROR_FILE);
        log_event('the minute check works again', true, 'normal');
    }
    return $code;
}

/** Does a folder contain nothing but real empty folders (no files, no links)? */
function tree_is_empty(string $dir): bool
{
    if (is_link($dir) || !is_dir($dir)) {
        return false;
    }
    $entries = @scandir($dir);
    if ($entries === false) {
        return false;
    }
    foreach ($entries as $entry) {
        if ($entry !== '.' && $entry !== '..' && !tree_is_empty("$dir/$entry")) {
            return false;
        }
    }
    return true;
}

/**
 * Remove a folder if it holds nothing but empty folders, without following
 * links. Checks the whole tree first so nothing is removed when a sibling
 * holds a file (audit S1). Returns true if it is gone.
 */
function remove_empty_tree(string $dir): bool
{
    if (!tree_is_empty($dir)) {
        return false;
    }
    $entries = @scandir($dir);
    if ($entries === false) {
        return false;
    }
    foreach ($entries as $entry) {
        if ($entry !== '.' && $entry !== '..' && !remove_empty_tree("$dir/$entry")) {
            return false;
        }
    }
    return @rmdir($dir);
}

/** Containers that DOC-6 failed to stop recently: container => timestamp. */
function stray_failed_state(): array
{
    $data = json_decode((string) read_marker(STRAY_FAILED_FILE), true);
    $state = [];
    foreach (is_array($data) ? $data : [] as $container => $since) {
        $container = (string) $container;
        if (preg_match(CONTAINER_PATTERN, $container) && is_int($since)) {
            $state[$container] = $since;
        }
    }
    return $state;
}

function save_stray_failed(array $state): void
{
    if ($state === []) {
        @unlink(STRAY_FAILED_FILE);
    } else {
        write_marker(STRAY_FAILED_FILE, json_encode($state));
    }
}

/**
 * Containers that are dependents of locked (or unmounted) volumes and of no
 * mounted volume: container => list of ['volume' => name, 'grace' => seconds].
 */
function wanted_stray_dependents(array $config, array $live): array
{
    $allowed = [];
    $wanted = [];
    foreach ($config as $name => $volume) {
        $name = (string) $name;
        // Only an actually mounted volume allows its dependents to run (audit B3).
        $mounted = ($live[$name]['mounted_at'] ?? null) !== null;
        foreach ($volume['dependents'] as $dependent) {
            if ($mounted) {
                $allowed[$dependent['container']] = true;
            } else {
                $wanted[$dependent['container']][] = ['volume' => $name, 'grace' => $dependent['grace']];
            }
        }
    }
    return array_diff_key($wanted, $allowed);
}

/**
 * DOC-6: a dependent that runs while its volume is locked writes into an empty
 * folder instead of the volume (under /mnt/addons/ that is RAM) and keeps the
 * volume from being mounted there. Stop it, with a notification. A container
 * that is a dependent of a mounted volume too is left alone.
 *
 * Docker is asked first without the lock and with a short limit, so a hanging
 * Docker service never holds up a mount; the lock is taken only when there is
 * something to stop, and both config and live state are reloaded under it.
 * Returns the containers stopped.
 */
function stray_dependents(): array
{
    $wanted = wanted_stray_dependents(load_config(), live_volumes());
    if ($wanted === [] || !array_started()) {
        if ($wanted === [] && read_marker(STRAY_FAILED_FILE) !== null) {
            @unlink(STRAY_FAILED_FILE);
        }
        return [];
    }
    // Only names, so Docker answers from memory and no disk is read. If Docker
    // is not running (or not answering), there is nothing to stop.
    $r = run([program('docker'), 'ps', '--format', '{{.Names}}'], 10);
    if ($r['code'] !== 0) {
        return [];
    }
    $running = array_values(array_intersect(array_keys($wanted), preg_split('/\n/', trim($r['out']))));
    $failed = stray_failed_state();
    $now = time();
    // Skip containers that failed to stop recently so cron does not hold the
    // lock and flood flash notifications every minute (audit S1).
    $to_stop = array_values(array_filter(
        $running,
        fn($c) => !isset($failed[(string) $c]) || ($now - $failed[(string) $c]) >= STRAY_BACKOFF
    ));
    if ($to_stop === []) {
        if ($failed !== []) {
            $kept = array_intersect_key($failed, array_flip(array_map('strval', $running)));
            if ($kept !== $failed) {
                save_stray_failed($kept);
            }
        }
        return [];
    }

    $lock = take_lock();
    // Reload both config and live state under the lock so a concurrent edit
    // or mount is respected (audit S1).
    $config = load_config();
    $live = live_volumes();
    $wanted = wanted_stray_dependents($config, $live);
    $failed = stray_failed_state();
    $failed_changed = false;
    $stopped = [];
    foreach ($to_stop as $container) {
        $container = (string) $container;
        if (!array_started() || stop_requested()) {
            break;
        }
        if (!isset($wanted[$container]) || container_running($container) !== true) {
            if (isset($failed[$container])) {
                unset($failed[$container]);
                $failed_changed = true;
            }
            continue;   // mounted, detached or stopped meanwhile
        }
        $volumes = array_column($wanted[$container], 'volume');
        $grace = max(array_column($wanted[$container], 'grace'));
        run([program('docker'), 'stop', '-t', (string) $grace, $container], $grace + 30);
        $done = container_running($container) === false;
        $vol_text = count($volumes) === 1
            ? "\"{$volumes[0]}\" is locked"
            : quoted_list($volumes) . ' are locked';
        $message = "dependent \"$container\" was started while $vol_text"
            . ($done ? ', so it was stopped' : ', and it could not be stopped');
        // Check every locked volume's mount folder (audit B3). Only remove our
        // own default /mnt/addons/<volume> folder, never custom paths or through
        // symlinks (audit S1).
        if ($done) {
            if (isset($failed[$container])) {
                unset($failed[$container]);
                $failed_changed = true;
            }
            $dirty_ram = false;
            $dirty_other = false;
            $mounts = mount_points();
            $addons_safe = !is_link('/mnt/addons');
            foreach ($volumes as $vol_name) {
                $point = $config[$vol_name]['mount_at'];
                $own_default = $point === "/mnt/addons/$vol_name";
                if (!is_dir($point) || is_link($point) || in_array($point, $mounts, true)) {
                    continue;
                }
                if ($own_default && $addons_safe && remove_empty_tree($point)) {
                    // nothing was written; the next mount works as usual
                } elseif (count(@scandir($point) ?: []) > 2) {
                    if ($own_default) {
                        $dirty_ram = true;
                    } else {
                        $dirty_other = true;
                    }
                }
            }
            if ($dirty_ram || $dirty_other) {
                $message .= '. It may have written into the volume\'s mount folder, which is not the volume'
                    . ($dirty_ram ? ' but RAM, lost at reboot' : '')
                    . '. Move or delete what is there before mounting the volume';
            }
            $stopped[] = $container;
        } else {
            $failed[$container] = time();
            $failed_changed = true;
        }
        log_event($message, true);
    }
    if ($failed_changed) {
        save_stray_failed($failed);
    }
    return $stopped;
}

/**
 * Ask a running unlock to stop (UI-8, review C3). Leaves a marker carrying the
 * token of the one unlock it is meant for; only that unlock honours it and ends
 * its own cryptsetup. Takes no lock, since the mount holds it.
 *
 * With --unlock-id <token> (from the web page): writes that token unless a
 * different unlock is already running (so a late cancel never hurts the next
 * unlock, while a very early cancel waits for its own mount).
 * Without --unlock-id (from SSH or array-stop hooks): reads the running
 * unlock's token from UNLOCKING_FILE and writes it; if no unlock is running,
 * does nothing.
 * With --array-stop (from the array-stop and Docker-stop hooks): also notes
 * the time in STOP_FILE, so the minute check and dependents' start delays give
 * way (audit 2026-11-27c S1).
 */
function command_cancel_unlock(array $args, ?string $unlock_id, bool $json, bool $array_stop = false): int
{
    if ($args !== [] || ($array_stop && $unlock_id !== null)) {
        throw new Fail('Usage: vcmount cancel-unlock [--unlock-id <id> | --array-stop]', CODE_USAGE);
    }
    if ($array_stop && !write_marker(STOP_FILE, (string) time())) {
        throw new Fail('Could not create ' . STOP_FILE . '.', CODE_USAGE);
    }
    if ($unlock_id !== null && !preg_match(UNLOCK_TOKEN_PATTERN, $unlock_id)) {
        throw new Fail('That is not a valid unlock identifier.', CODE_USAGE);
    }
    $current = read_unlocking_marker();
    $current_token = $current['token'] ?? null;
    $target = null;
    if ($unlock_id !== null) {
        if ($current_token === null || $current_token === $unlock_id) {
            $target = $unlock_id;
        }
    } elseif ($current_token !== null) {
        $target = $current_token;
    }
    if ($target !== null && !write_marker(CANCEL_FILE, $target)) {
        throw new Fail('Could not create ' . CANCEL_FILE . '.', CODE_USAGE);
    }
    if ($json) {
        echo json_encode(['ok' => true]), "\n";
    } else {
        echo $target !== null ? "Asked the running unlock to stop.\n" : "No unlock is running.\n";
    }
    return CODE_OK;
}

/**
 * Is another vcmount action running right now? Tries the lock without waiting
 * and lets it go at once. The web page uses this after a lost answer.
 */
function command_busy(array $args, bool $json): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount busy', CODE_USAGE);
    }
    $busy = false;
    if (file_exists(RUN_DIR) || is_link(RUN_DIR)) {
        if (!run_dir_safe()) {
            throw new Fail('Refused: ' . RUN_DIR . ' is not a root-owned folder.', CODE_REFUSED);
        }
        if (is_link(LOCK_FILE)) {
            throw new Fail('Refused: ' . LOCK_FILE . ' is a link.', CODE_REFUSED);
        }
        if (is_file(LOCK_FILE)) {
            $handle = @fopen(LOCK_FILE, 'ce');
            $busy = $handle !== false && !flock($handle, LOCK_EX | LOCK_NB);
            if ($handle !== false) {
                fclose($handle);   // also lets go of the lock if we got it
            }
        }
    }
    // Seconds since a running password check started, and its opaque token for
    // "Stop that unlock", or null (review C3).
    $marker = $busy ? read_unlocking_marker() : null;
    $unlocking_for = $marker !== null ? max(0, time() - $marker['since']) : null;
    $unlock_id = $marker['token'] ?? null;
    if ($json) {
        echo json_encode(['ok' => true, 'busy' => $busy, 'unlocking_for' => $unlocking_for, 'unlock_id' => $unlock_id]), "\n";
    } else {
        echo $busy ? "Another vcmount action is running.\n" : "No vcmount action is running.\n";
    }
    return CODE_OK;
}

/** File systems with real owners, where a share may be blocked by the top folder. */
const OWNER_FILESYSTEMS = ['ext2', 'ext3', 'ext4', 'xfs', 'btrfs'];
const SHARE_UID = 99;    // nobody, as which the plugin's shares write (force user)
const SHARE_GID = 100;   // users

/** Can the share's user (nobody:users) create files in this folder? */
function share_can_write(string $dir): bool
{
    $st = @stat($dir);
    if ($st === false) {
        return false;
    }
    $mode = $st['mode'];
    // As the kernel decides: the owner's bits if nobody owns it, else the
    // group's if it belongs to users, else everyone's. Samba needs read,
    // write and enter (audit B3).
    if ($st['uid'] === SHARE_UID) {
        return ($mode & 0700) === 0700;
    }
    if ($st['gid'] === SHARE_GID) {
        return ($mode & 0070) === 0070;
    }
    return ($mode & 0007) === 0007;
}

/**
 * Is the network share of a mounted volume blocked by its top folder? Only for
 * a saved volume with a share that gives someone write access, mounted
 * read-write, with a file system that has owners (ext4, XFS, Btrfs). The page
 * then asks whether to change the folder (fix-top); the mount never does.
 */
function top_folder_blocked(string $name, ?array $saved): bool
{
    $live = live_volumes()[$name] ?? null;
    if ($saved === null || $live === null || $live['mounted_at'] === null || $live['read_only']) {
        return false;
    }
    if (!in_array($live['filesystem'] ?? '', OWNER_FILESYSTEMS, true)) {
        return false;
    }
    $writers = array_filter($saved['share']['users'] ?? [], fn($a) => $a === 'read-write');
    return $writers !== [] && !share_can_write($live['mounted_at']);
}

/** The mount point of a volume mounted read-write with a file system that has owners. */
function owner_fs_point(string $name): string
{
    if (!preg_match(NAME_PATTERN, $name)) {
        throw new Fail('That is not a valid volume name.', CODE_USAGE);
    }
    $live = live_volumes()[$name] ?? null;
    if ($live === null || $live['mounted_at'] === null) {
        throw new Fail("\"$name\" is not mounted.", CODE_USAGE);
    }
    if ($live['read_only']) {
        throw new Fail("\"$name\" is mounted read-only. Mount it read-write first.", CODE_REFUSED);
    }
    if (!in_array($live['filesystem'] ?? '', OWNER_FILESYSTEMS, true)) {
        throw new Fail("\"$name\" has no owners to change ({$live['filesystem']}): every file already appears as nobody:users.", CODE_REFUSED);
    }
    return $live['mounted_at'];
}

/**
 * Make only the top folder of a mounted ext4, XFS or Btrfs volume belong to
 * nobody:users and writable for all, as Unraid keeps its share folders, so the
 * volume's network share can write to it. Nothing inside is changed. Run only
 * when the user asked for it (the page's question after mounting).
 */
function command_fix_top(array $args, bool $json): int
{
    if (count($args) !== 1) {
        throw new Fail('Usage: vcmount fix-top <name>', CODE_USAGE);
    }
    // The lock first, so the volume cannot be dismounted between the check
    // that it is mounted and the change (audit S7).
    $lock = take_lock();
    $point = owner_fs_point($args[0]);
    if (!@chown($point, SHARE_UID) || !@chgrp($point, SHARE_GID) || !@chmod($point, 0777)) {
        throw new Fail("Could not change the top folder $point.", CODE_USAGE);
    }
    $message = "The top folder of \"{$args[0]}\" now belongs to nobody:users and is writable for its network share.";
    echo $json ? json_encode(['ok' => true, 'message' => $message], JSON_UNESCAPED_SLASHES) . "\n" : "$message\n";
    return CODE_OK;
}

/**
 * Set everything inside a mounted volume to nobody:users, folders writable for
 * all and files readable and writable for all: Unraid's own New Permissions
 * tool (/usr/local/sbin/newperms). It can run for a long time on a large
 * volume, so it is started in the background and this command returns at once.
 * The page asks for confirmation first: it can break containers that need
 * their own owners.
 */
function command_fix_permissions(array $args, bool $json): int
{
    if (count($args) !== 1) {
        throw new Fail('Usage: vcmount fix-permissions <name>', CODE_USAGE);
    }
    $lock = take_lock();   // as fix-top (audit S7)
    $point = owner_fs_point($args[0]);
    $tool = '/usr/local/sbin/newperms';
    if (!is_executable($tool)) {
        throw new Fail("Unraid's permission tool $tool was not found.", CODE_USAGE);
    }
    // newperms splits its argument at "*" and decodes "%xx" (checked on Unraid
    // 7.4), so such a path would reach other folders.
    if (strpbrk($point, '*%') !== false) {
        throw new Fail("Unraid's permission tool cannot handle the mount location $point (it contains * or %).", CODE_REFUSED);
    }
    // Not twice at once on the same folder (audit 2026-11-27c S5): it runs on
    // in the background after this command ends.
    foreach (glob('/proc/[0-9]*/cmdline') ?: [] as $cmdline) {
        $parts = explode("\0", (string) @file_get_contents($cmdline));
        if (in_array($tool, $parts, true) && in_array($point, $parts, true)) {
            throw new Fail("Fixing the permissions of \"{$args[0]}\" is still running.", CODE_IN_PROGRESS);
        }
    }
    // In the background, cut loose from this program's output: the folder is
    // passed as an argument, never as part of a command line.
    run([program('sh'), '-c', 'exec "$0" "$1" >/dev/null 2>&1 </dev/null &', $tool, $point], TOOL_TIMEOUT);
    $message = "Setting everything inside \"{$args[0]}\" to nobody:users has started. On a large volume this can take a while.";
    echo $json ? json_encode(['ok' => true, 'message' => $message], JSON_UNESCAPED_SLASHES) . "\n" : "$message\n";
    return CODE_OK;
}

/** The plugin's log lines in the system log, newest last, that mention one volume. */
const SYSLOG = '/var/log/syslog';
const INFO_LOG_LINES = 15;
const INFO_LOG_TAIL = 2 * 1024 * 1024;   // read at most the last 2 MB of the system log

function volume_log_lines(string $name): array
{
    $handle = @fopen(SYSLOG, 'r');
    if ($handle === false) {
        return [];
    }
    $size = filesize(SYSLOG) ?: 0;
    if ($size > INFO_LOG_TAIL) {
        fseek($handle, $size - INFO_LOG_TAIL);
        fgets($handle);   // drop the line cut in half
    }
    $lines = [];
    // Log lines name a volume in double quotes, and names are only letters,
    // digits, - and _, so this cannot match a longer name by accident.
    $needle = '"' . $name . '"';
    while (($line = fgets($handle)) !== false) {
        if (strpos($line, 'veracrypt.mount') !== false && strpos($line, $needle) !== false) {
            $lines[] = rtrim($line, "\n");
            if (count($lines) > INFO_LOG_LINES) {
                array_shift($lines);
            }
        }
    }
    fclose($handle);
    return $lines;
}

/**
 * Details of one volume for the information window (the drive icon in the web
 * pages): the volume file, and while unlocked the encryption, device, file
 * system and mount options, then share, dependents and recent log lines.
 * Reads only; never needs the password. For a volume that is not saved
 * ("mount once") only its live state is shown and no log lines are searched.
 */
function command_info(array $args, bool $json): int
{
    if (count($args) !== 1) {
        throw new Fail('Usage: vcmount info <name>', CODE_USAGE);
    }
    $name = $args[0];
    if (!preg_match(NAME_PATTERN, $name)) {
        throw new Fail('That is not a valid volume name.', CODE_USAGE);
    }
    $saved = load_config()[$name] ?? null;
    $live = live_volumes()[$name] ?? null;
    if ($saved === null && $live === null) {
        throw new Fail("There is no volume named \"$name\".", CODE_USAGE);
    }
    $v = describe($name, $saved, $live);

    $info = ['volume' => $v, 'file' => null, 'crypt' => null, 'filesystem' => null,
             'dependents' => [], 'log' => []];

    if (is_string($v['file']) && is_file($v['file'])) {
        $bytes = @filesize($v['file']);
        $changed = @filemtime($v['file']);
        $info['file'] = ['size_bytes' => $bytes === false ? null : $bytes,
                         'modified' => $changed === false ? null : date('c', $changed)];
    }

    if ($live !== null) {
        $device = MAPPER_DIR . '/' . MAPPER_PREFIX . $name;
        $r = run([program('cryptsetup'), 'status', MAPPER_PREFIX . $name], TOOL_TIMEOUT);
        $crypt = [];
        foreach (preg_split('/\n/', $r['out']) as $line) {
            if (preg_match('/^\s*(type|cipher|keysize|device|loop|sector size|size|mode):\s*(.+)$/', $line, $m)) {
                $crypt[str_replace(' ', '_', $m[1])] = trim($m[2]);
            }
        }
        $info['crypt'] = $crypt ?: null;

        $fs = [];
        $r = run([program('blkid'), '-p', '-o', 'export', $device], TOOL_TIMEOUT);
        foreach (preg_split('/\n/', $r['out']) as $line) {
            if (preg_match('/^(TYPE|LABEL|UUID)=(.*)$/', $line, $m)) {
                $fs[strtolower($m[1])] = $m[2];
            }
        }
        if ($v['mounted_at'] !== null) {
            foreach (@file('/proc/mounts', FILE_IGNORE_NEW_LINES) ?: [] as $line) {
                $f = explode(' ', $line);
                if (count($f) >= 4 && unescape_mount_field($f[1]) === $v['mounted_at']) {
                    $fs['driver'] = $f[2];
                    $fs['options'] = $f[3];
                }
            }
        }
        $info['filesystem'] = $fs ?: null;
        if ($v['mounted_at'] !== null && ($st = @stat($v['mounted_at'])) !== false) {
            $posix = function_exists('posix_getpwuid');   // the names, if PHP's posix module is there
            $owner = ($posix ? (posix_getpwuid($st['uid'])['name'] ?? null) : null) ?? (string) $st['uid'];
            $group = ($posix ? (posix_getgrgid($st['gid'])['name'] ?? null) : null) ?? (string) $st['gid'];
            $info['top_folder'] = ['owner' => "$owner:$group", 'mode' => sprintf('%04o', $st['mode'] & 07777),
                                   'share_can_write' => share_can_write($v['mounted_at']),
                                   'owners' => in_array($live['filesystem'] ?? '', OWNER_FILESYSTEMS, true)];
        }
    }

    if ($saved !== null) {
        $ready = docker_ready();
        foreach ($saved['dependents'] as $dependent) {
            $running = $ready ? container_running($dependent['container']) : null;
            $info['dependents'][] = [
                'container' => $dependent['container'],
                'state' => !$ready ? 'unknown' : ($running === null ? 'not found' : ($running ? 'running' : 'stopped')),
                'grace' => $dependent['grace'],
                'delay' => $dependent['delay'],
            ];
        }
        // Older lines may still name the volume; with the setting off none are shown.
        $info['log_names'] = setting('log_names', SETTINGS['log_names']);
        $info['log'] = $info['log_names'] ? volume_log_lines($name) : [];
    }

    if ($json) {
        echo json_encode(['ok' => true] + $info, JSON_UNESCAPED_SLASHES), "\n";
        return CODE_OK;
    }
    echo 'Name:        ', $v['name'], $v['saved'] ? '' : ' (not saved)', "\n";
    echo 'State:       ', $v['state'], "\n";
    echo 'Volume file: ', $v['file'] ?? '-', "\n";
    if ($info['file'] !== null) {
        echo '             ', format_size($info['file']['size_bytes']), ', changed ', $info['file']['modified'], "\n";
    }
    foreach ($info['crypt'] ?? [] as $key => $value) {
        printf("%-13s%s\n", ucfirst(str_replace('_', ' ', $key)) . ':', $value);
    }
    foreach ($info['filesystem'] ?? [] as $key => $value) {
        printf("%-13s%s\n", ucfirst($key) . ':', $value);
    }
    foreach ($info['dependents'] as $d) {
        echo 'Dependent:   ', $d['container'], ' (', $d['state'], ")\n";
    }
    foreach ($info['log'] as $line) {
        echo 'Log:         ', $line, "\n";
    }
    return CODE_OK;
}

/**
 * The fingerprint of the settings file's content, or "none" when there is no
 * file. The web page sends it back when saving, so a change made meanwhile
 * elsewhere (another browser tab) is not overwritten unseen.
 */
function revision_of(?string $content): string
{
    return $content === null ? 'none' : hash('sha256', $content);
}

/** The settings file's content, or null when there is none. */
function config_content(): ?string
{
    $path = config_path();
    if (!is_file($path)) {
        return null;
    }
    $content = @file_get_contents($path);
    if ($content === false) {
        throw new Fail("Could not read $path.", CODE_USAGE);
    }
    return $content;
}

/** Show the saved settings as they are stored, with their revision. Changes nothing. */
function command_config(array $args, bool $json): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount config', CODE_USAGE);
    }
    $content = config_content();
    $checked = $content === null
        ? ['volumes' => [], 'settings' => SETTINGS]
        : check_config(json_decode($content, true), 'The configuration file ' . config_path());
    $out = [
        'ok' => true,
        'revision' => revision_of($content),
        'settings' => $checked['settings'],
        'volumes' => array_values(array_map('volume_for_file', $checked['volumes'])),
    ];
    if ($json) {
        echo json_encode($out, JSON_UNESCAPED_SLASHES), "\n";
    } else {
        unset($out['ok']);
        echo json_encode($out, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    }
    return CODE_OK;
}

/** One volume as it is written to the file: only what differs from the defaults. */
function volume_for_file(array $v): array
{
    $out = ['name' => $v['name']];
    if ($v['display_name'] !== $v['name']) {
        $out['display_name'] = $v['display_name'];
    }
    $out['file'] = $v['file'];
    if ($v['mount_at'] !== '/mnt/addons/' . $v['name']) {
        $out['mount_at'] = $v['mount_at'];
    }
    if ($v['read_only']) {
        $out['read_only'] = true;
    }
    if ($v['hidden']) {
        $out['hidden'] = true;
    }
    if ($v['pim']) {
        $out['pim'] = true;   // only that it asks for one, never the PIM itself
    }
    if ($v['keyfiles'] !== []) {
        $out['keyfiles'] = $v['keyfiles'];
    }
    if ($v['share'] !== null) {
        $out['share'] = $v['share'];
    }
    if ($v['dependents'] !== []) {
        $out['dependents'] = $v['dependents'];
    }
    if ($v['idle_lock'] !== null) {
        $out['idle_lock'] = $v['idle_lock'];
    }
    return $out;
}

/**
 * Check new settings and save them (Decision U1). They arrive as JSON on
 * standard input, are checked with the same rules as when they are read, and
 * replace the file in one step. The only place where the plugin writes the
 * flash drive at runtime (Decision D4). Changes to a mounted volume take
 * effect at its next mount.
 */
function command_save_config(array $args, ?string $revision, bool $json): int
{
    if ($args !== []) {
        throw new Fail('Usage: vcmount save-config [--revision <r>] < settings.json', CODE_USAGE);
    }
    if ($revision !== null && !preg_match('/\A([0-9a-f]{64}|none)\z/', $revision)) {
        throw new Fail('That is not a valid revision.', CODE_USAGE);
    }
    $text = stream_get_contents(STDIN, MAX_CONFIG_SIZE + 1);
    if ($text === false || strlen($text) > MAX_CONFIG_SIZE) {
        throw new Fail('The new settings could not be read or are too large.', CODE_USAGE);
    }
    $checked = check_config(json_decode($text, true), 'The new configuration');

    $out = [
        'settings' => $checked['settings'],
        'volumes' => array_values(array_map('volume_for_file', $checked['volumes'])),
    ];
    $content = json_encode($out, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";

    $lock = take_lock();

    // Refuse to overwrite a change made meanwhile elsewhere.
    $current = config_content();
    if ($revision !== null && $revision !== revision_of($current)) {
        throw new Fail('The settings were changed elsewhere in the meantime, perhaps in another browser tab. '
            . 'Reload them and make your change again.', CODE_REFUSED);
    }

    // Decision D3: a mounted volume may not be renamed or removed. It would turn
    // into a volume that is not saved, and its dependents would no longer be
    // stopped when it is dismounted.
    try {
        $old = $current === null ? [] : check_config(json_decode($current, true), 'The saved settings')['volumes'];
    } catch (Fail $e) {
        $old = [];   // a broken old file must not block saving a good new one
    }
    foreach (array_keys(live_volumes()) as $name) {
        $name = (string) $name;
        if (isset($old[$name]) && !isset($checked['volumes'][$name])) {
            throw new Fail("\"$name\" is mounted. Dismount it before you rename or remove it.", CODE_REFUSED);
        }
    }

    $path = config_path();
    $dir = dirname($path);
    if (!is_dir($dir) && !@mkdir($dir, 0777, true)) {
        throw new Fail("Could not create the folder $dir.", CODE_USAGE);
    }
    $temp = "$path.new";
    if (@file_put_contents($temp, $content) === false || !@rename($temp, $path)) {
        @unlink($temp);
        throw new Fail("Could not write $path. The old settings are unchanged.", CODE_USAGE);
    }
    log_event('settings saved');

    if ($json) {
        echo json_encode(['ok' => true, 'volumes' => count($out['volumes']), 'revision' => revision_of($content)],
            JSON_UNESCAPED_SLASHES), "\n";
    } else {
        echo 'Saved the settings (', count($out['volumes']), " volumes).\n";
    }
    return CODE_OK;
}

/** Split the command line into plain arguments and options. */
function parse_args(array $args): array
{
    $flags = [
        '--json' => 'json', '--read-only' => 'read_only', '--all' => 'all',
        '--force' => 'force', '--array-stop' => 'array_stop', '--over-http' => 'over_http',
        '--pim' => 'pim', '--no-pim' => 'no_pim', '--no-password' => 'no_password', '--hidden' => 'hidden',
    ];
    $values = ['--file' => 'file', '--name' => 'name', '--revision' => 'revision', '--within' => 'within',
               '--unlock-id' => 'unlock_id'];
    $options = [
        'json' => false, 'read_only' => false, 'all' => false, 'force' => false, 'array_stop' => false,
        'over_http' => false, 'pim' => false, 'no_pim' => false, 'no_password' => false, 'hidden' => false,
        'file' => null, 'name' => null, 'revision' => null, 'keyfile' => [], 'within' => null, 'unlock_id' => null,
    ];
    $plain = [];
    while ($args !== []) {
        $arg = array_shift($args);
        if (isset($flags[$arg])) {
            $options[$flags[$arg]] = true;
        } elseif ($arg === '--keyfile') {
            // May be given more than once.
            if ($args === []) {
                throw new Fail('--keyfile needs a value.', CODE_USAGE);
            }
            $options['keyfile'][] = array_shift($args);
        } elseif (isset($values[$arg])) {
            if ($args === []) {
                throw new Fail("$arg needs a value.", CODE_USAGE);
            }
            $options[$values[$arg]] = array_shift($args);
        } elseif ($arg !== '--help' && strlen($arg) > 1 && $arg[0] === '-') {
            // Also short ones such as -h: no name or path starts with a dash.
            throw new Fail("Unknown option $arg.", CODE_USAGE);
        } else {
            $plain[] = $arg;
        }
    }
    return [$plain, $options];
}

function main(array $argv): int
{
    $json = in_array('--json', $argv, true);
    try {
        [$args, $options] = parse_args(array_slice($argv, 1));
        $command = array_shift($args);
        switch ($command) {
            case 'list':
                if ($args !== []) {
                    throw new Fail('Usage: vcmount list', CODE_USAGE);
                }
                return command_list($json);
            case 'status':
                return command_status($args, $json);
            case 'mount':
                return command_mount($args, $options, $json);
            case 'dismount':
                return command_dismount($args, $options, $json);
            case 'stop-dependents':
                return command_stop_dependents($args, $options, $json);
            case 'start-dependents':
                return command_start_dependents($args, $options, $json);
            case 'repair-shares':
                return command_repair_shares($args, $json);
            case 'options':
                return command_options($args, $json);
            case 'busy':
                return command_busy($args, $json);
            case 'check':
            case 'idle-check':
                return minute_check_reported($args, $json);
            case 'cancel-unlock':
                return command_cancel_unlock($args, $options['unlock_id'], $json, $options['array_stop']);
            case 'privacy':
                return command_privacy($args, $json);
            case 'info':
                return command_info($args, $json);
            case 'fix-top':
                return command_fix_top($args, $json);
            case 'fix-permissions':
                return command_fix_permissions($args, $json);
            case 'config':
                return command_config($args, $json);
            case 'save-config':
                return command_save_config($args, $options['revision'], $json);
            case 'help':
            case '--help':
                echo USAGE, "\n";
                return CODE_OK;
            default:
                throw new Fail(USAGE, CODE_USAGE);
        }
    } catch (Fail $e) {
        if ($json) {
            echo json_encode(
                ['ok' => false, 'code' => $e->getCode(), 'error' => $e->getMessage(), 'details' => $e->details],
                JSON_UNESCAPED_SLASHES
            ), "\n";
        } else {
            fwrite(STDERR, $e->getMessage() . "\n");
            foreach ($e->details['programs'] ?? [] as $program) {
                fwrite(STDERR, "  held open by: $program\n");
            }
        }
        return $e->getCode();
    }
}

exit(main($argv));
